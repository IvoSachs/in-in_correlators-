Notebook[{Cell["The partial_a differential system for the I011 pinch", 
   "Title"], Cell["This notebook specifically derives partial_a I011. It is \
not the partial_b equation obtained from the I110 system by substitution. The \
notebook constructs the master basis, the exact connection matrix, the \
leading-singularity triangular form at epsilon=0, and the exact \
finite-epsilon Riccati triangularization.", "Text"], 
  Cell["1. Load the implementation", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], ";", 
      RowBox[{"notebookDirectory", "=", RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", RowBox[{RowBox[{"NotebookDirectory", "[", 
                "]"}], ",", RowBox[{"DirectoryName", "[", "$InputFileName", 
                "]"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"notebookDirectory", ",", 
              "\"CosmologicalBaikov.wl\""}], "}"}], "]"}], "]"}], ";", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"notebookDirectory", ",", 
              "\"CosmologicalBaikov011.wl\""}], "}"}], "]"}], "]"}], ";"}]], 
   "Input"], Cell["2. Why this is the a derivative", "Section"], 
  Cell["Write Lambda=c p2.p3-b p2^2-a p3^2+lambda0 with lambda0=c^2/4-a b. \
Therefore partial_a Lambda=-(p3^2+b)=-D6. In the I011 sector D3=p3^2+x3^2, so \
D6=D3+b-x3^2. By contrast partial_b Lambda=-(p2^2+a)=-D5.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"xScalar", ",", 
          "yScalar", ",", "zScalar", ",", "d3Scalar"}], "]"}], ";", 
      RowBox[{"lambdaScalar", "=", RowBox[{RowBox[{"cK", " ", "zScalar"}], 
          "-", RowBox[{"bK", " ", "xScalar"}], "-", 
          RowBox[{"aK", " ", "yScalar"}], "+", RowBox[{"Lambda0", "[", 
            "]"}]}]}], ";", RowBox[{"d6Scalar", "=", 
        RowBox[{"yScalar", "+", "bK"}]}], ";", 
      RowBox[{"d3Scalar", "=", RowBox[{"yScalar", "+", "x3sq"}]}], ";", 
      RowBox[{"{", RowBox[{RowBox[{"Expand", "[", 
            RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"aK"}]], 
                "lambdaScalar"}], "+", "d6Scalar"}], "]"}], ",", 
          RowBox[{"Expand", "[", RowBox[{"d6Scalar", "-", RowBox[{"(", 
                RowBox[{"d3Scalar", "+", "bK", "-", "x3sq"}], ")"}]}], 
            "]"}]}], "}"}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"rawDerivativeExample", "=", 
        RowBox[{"ParameterDerivativeA011", "[", RowBox[{"1", ",", "1", ",", 
            "0"}], "]"}]}], ";", RowBox[{"scalingIdentityExample", "=", 
        RowBox[{"ScalingIdentity011", "[", RowBox[{"1", ",", "1", ",", "0"}], 
          "]"}]}], ";", RowBox[{"{", RowBox[{"scalingIdentityExample", ",", 
          "rawDerivativeExample"}], "}"}]}]], "Input"], 
  Cell["3. Master basis and IBP closure", "Section"], 
  Cell["Use J011[s,w,v]=Ibar^(0 s w,v 0 0;0), where s and w are the D2 and D3 \
powers and v is the D4 power. Four vector IBPs together with one-denominator \
Hermite reduction close on five masters.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"basis011Da", "=", 
        RowBox[{"MasterBasis011", "[", "]"}]}], ";", 
      RowBox[{"reduction011Da", "=", RowBox[{"ReductionData011", "[", 
          "]"}]}], ";", RowBox[{"genericPoint011Da", "=", 
        RowBox[{"{", RowBox[{RowBox[{"aK", "\[Rule]", "5"}], ",", 
            RowBox[{"bK", "\[Rule]", RowBox[{"-", "1"}]}], ",", 
            RowBox[{"cK", "\[Rule]", "1"}], ",", RowBox[{"x2sq", "\[Rule]", 
              "1"}], ",", RowBox[{"x3sq", "\[Rule]", "2"}], ",", 
            RowBox[{"eps", "\[Rule]", FractionBox["1", "7"]}]}], "}"}]}], 
      ";", RowBox[{"mixedRanks011Da", "=", 
        RowBox[{RowBox[{"(", RowBox[{RowBox[{"MatrixRank", "[", 
                RowBox[{"#1", "/.", "\[VeryThinSpace]", 
                  "genericPoint011Da"}], "]"}], "&"}], ")"}], "/@", 
          RowBox[{"reduction011Da", "[", "\"MixedMatrices\"", "]"}]}]}], ";", 
      RowBox[{"{", RowBox[{"basis011Da", ",", "mixedRanks011Da", ",", 
          RowBox[{"Together", "[", RowBox[{RowBox[{"reduction011Da", "[", 
                "\"FourthIBPResidual\"", "]"}], "/.", "\[VeryThinSpace]", 
              "genericPoint011Da"}], "]"}]}], "}"}]}]], "Input"], 
  Cell["In full notation the basis is {I000,000;0, I010,000;0, I001,000;0, \
I011,000;0, I011,-100;0}. The 4 x 4 system at v=0 and the 3 x 3 system at \
v=-1 have full rank at generic kinematics.", "Text"], 
  Cell["4. Exact partial_a connection matrix", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"connection011Da", "=", 
        RowBox[{"DifferentialMatrixA011", "[", "]"}]}], ";", 
      RowBox[{"lowerRows011Da", "=", RowBox[{"Map", "[", 
          RowBox[{"Together", ",", RowBox[{"connection011Da", 
              "\[LeftDoubleBracket]", RowBox[{"1", ";;", "3"}], 
              "\[RightDoubleBracket]"}], ",", RowBox[{"{", "2", "}"}]}], 
          "]"}]}], ";", RowBox[
       {"{", RowBox[{RowBox[{"Dimensions", "[", "connection011Da", "]"}], 
          ",", TagBox["lowerRows011Da", Function[BoxForm`e$, 
            MatrixForm[BoxForm`e$]]]}], "}"}]}]], "Input"], 
  Cell["The exact fourth and fifth rows are rational functions generated by \
the two mixed IBP systems. They are stored without expensive cosmetic \
simplification. Use DifferentialMatrixA011[\"SimplifyFunction\"->Together] \
when a single fully combined denominator is required.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"connectionAtPoint011Da", "=", 
        RowBox[{"NumericalCrossCheck011", "[", "]"}]}], ";", 
      TagBox["connectionAtPoint011Da", Function[BoxForm`e$, 
        MatrixForm[BoxForm`e$]]]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"expectedConnection011Da", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", FractionBox[
                   "4", "147"]}], ",", "0", ",", "0", ",", "0", ",", "0"}], 
              "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", FractionBox["3", 
                   "280"]}], ",", RowBox[{"-", FractionBox["311", "2940"]}], 
                ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{"0", ",", "0", ",", RowBox[{"-", FractionBox[
                   "4", "147"]}], ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"-", FractionBox["165", "45038"]}], 
                ",", RowBox[{"-", FractionBox["895", "472899"]}], ",", 
                FractionBox["976", "472899"], ",", RowBox[{"-", FractionBox[
                   "2526", "22519"]}], ",", FractionBox["264", "22519"]}], 
              "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", FractionBox["72", 
                   "22519"]}], ",", RowBox[{"-", FractionBox["1366", 
                   "472899"]}], ",", RowBox[{"-", FractionBox["184", 
                   "157633"]}], ",", FractionBox["954", "22519"], ",", 
                RowBox[{"-", FractionBox["3630", "22519"]}]}], "}"}]}], 
          "}"}]}], ";", RowBox[
       {"{", RowBox[{RowBox[{"VerificationTest", "[", 
            RowBox[{"connectionAtPoint011Da", ",", "expectedConnection011Da", 
              ",", RowBox[{"TestID", "\[Rule]", 
                "\"partial-a-I011-connection\""}]}], "]"}], ",", 
          RowBox[{"VerificationTest", "[", RowBox[{RowBox[{"FreeQ", "[", 
                RowBox[{"connection011Da", ",", "_J011"}], "]"}], ",", 
              "True", ",", RowBox[{"TestID", "\[Rule]", 
                "\"partial-a-I011-IBP-closure\""}]}], "]"}]}], "}"}]}]], 
   "Input"], Cell["5. Leading singularities", "Section"], 
  Cell["On D2=D3=0 the Gram polynomial is x2^2 x3^2-(D4-c/2)^2. Since the \
fifth master contains one D4 numerator relative to the fourth, their \
leading-singularity ratio on a branch is the corresponding D4 value.", 
   "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"cutLocations011Da", "=", 
        RowBox[{"LeadingSingularityLocations011", "[", "]"}]}], ";", 
      RowBox[{"cutBasis011Da", "=", RowBox[
         {"LeadingSingularityBasisMatrix011", "[", "]"}]}], ";", 
      RowBox[{"leadingSingularityRows011Da", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", RowBox[
                 {"cutLocations011Da", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{"1", ",", RowBox[{"cutLocations011Da", 
                  "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
              "}"}]}], "}"}]}], ";", 
      RowBox[{"{", RowBox[{"cutLocations011Da", ",", 
          RowBox[{"cutBasis011Da", ".", RowBox[{"basis011Da", 
              "\[LeftDoubleBracket]", RowBox[{"4", ";;", "5"}], 
              "\[RightDoubleBracket]"}]}], ",", RowBox[{"Simplify", "[", 
            RowBox[{"cutBasis011Da", ".", TemplateBox[{
                "leadingSingularityRows011Da"}, "Transpose", SyntaxForm -> 
                SuperscriptBox]}], "]"}]}], "}"}]}]], "Input"], 
  Cell["6. Algebraic triangular form at epsilon=0", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"fullCutBasis011Da", "=", 
        RowBox[{"ArrayFlatten", "[", RowBox[
           {"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"IdentityMatrix", "[", 
                    "3", "]"}], ",", RowBox[{"ConstantArray", "[", 
                    RowBox[{"0", ",", RowBox[{"{", RowBox[{"3", ",", "2"}], 
                        "}"}]}], "]"}]}], "}"}], ",", RowBox[{"{", 
                RowBox[{RowBox[{"ConstantArray", "[", RowBox[{"0", ",", 
                      RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "]"}], 
                  ",", "cutBasis011Da"}], "}"}]}], "}"}], "]"}]}], ";", 
      RowBox[{"cutConnection011Da", "=", RowBox[{"TransformConnection", "[", 
          RowBox[{"connection011Da", ",", "fullCutBasis011Da", ",", "aK"}], 
          "]"}]}], ";", RowBox[{"triangularConnection011Da", "=", 
        RowBox[{"cutConnection011Da", "/.", "\[VeryThinSpace]", 
          RowBox[{"eps", "\[Rule]", "0"}]}]}], ";", 
      RowBox[{"topOffDiagonal011Da", "=", 
        RowBox[{"{", RowBox[{RowBox[{"cutConnection011Da", 
              "\[LeftDoubleBracket]", RowBox[{"4", ",", "5"}], 
              "\[RightDoubleBracket]"}], ",", RowBox[{"cutConnection011Da", 
              "\[LeftDoubleBracket]", RowBox[{"5", ",", "4"}], 
              "\[RightDoubleBracket]"}]}], "}"}]}], ";", 
      RowBox[{"sourceColumns23011Da", "=", RowBox[{"Map", "[", 
          RowBox[{"Together", ",", RowBox[{"triangularConnection011Da", 
              "\[LeftDoubleBracket]", RowBox[{RowBox[{"4", ";;", "5"}], ",", 
                RowBox[{"2", ";;", "3"}]}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      RowBox[{"{", RowBox[{RowBox[{"Together", "[", 
            RowBox[{"topOffDiagonal011Da", "/.", "\[VeryThinSpace]", 
              RowBox[{"eps", "\[Rule]", "0"}]}], "]"}], ",", 
          "sourceColumns23011Da"}], "}"}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"triangularPointRules011Da", "=", 
        RowBox[{"{", RowBox[{RowBox[{"aK", "\[Rule]", "5"}], ",", 
            RowBox[{"bK", "\[Rule]", RowBox[{"-", "1"}]}], ",", 
            RowBox[{"cK", "\[Rule]", "1"}], ",", RowBox[{"x2sq", "\[Rule]", 
              "1"}], ",", RowBox[{"x3sq", "\[Rule]", "2"}]}], "}"}]}], ";", 
      RowBox[{"upperEntriesAtPoint011Da", "=", 
        RowBox[{"Flatten", "[", RowBox[{"Table", "[", 
            RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"j", ">", "i"}], ",", 
                  RowBox[{"Together", "[", RowBox[{RowBox[
                       {"triangularConnection011Da", "\[LeftDoubleBracket]", 
                        RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], 
                      "/.", "\[VeryThinSpace]", 
                      "triangularPointRules011Da"}], "]"}], ",", "Nothing"}], 
                "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "5"}], "}"}], ",", 
              RowBox[{"{", RowBox[{"j", ",", "5"}], "}"}]}], "]"}], "]"}]}], 
      ";", RowBox[{"VerificationTest", "[", 
        RowBox[{"upperEntriesAtPoint011Da", ",", RowBox[{"ConstantArray", 
            "[", RowBox[{"0", ",", RowBox[{"Length", "[", 
                "upperEntriesAtPoint011Da", "]"}]}], "]"}], ",", 
          RowBox[{"TestID", "\[Rule]", 
            "\"partial-a-I011-lower-triangular-at-epsilon-zero\""}]}], 
        "]"}]}]], "Input"], Cell["At epsilon=0 the top block is diagonal, so \
the complete five-master connection is lower triangular. Moreover, the two \
top masters are sourced only by the vacuum master; their source columns for \
I010 and I001 vanish identically. At nonzero epsilon the two top off-diagonal \
entries are proportional to epsilon.", "Text"], 
  Cell["7. Exact finite-epsilon triangular form", "Section"], 
  Cell["Leading singularities determine the epsilon=0 branches. For exact \
finite-epsilon triangularity, define N=M5+rho(a)M4 and order the top pair as \
{N,M4}. Because the basis is a-dependent, the gauge term (partial_a T)T^(-1) \
is essential.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"rho", ",", "aa"}], 
        "]"}], ";", RowBox[{"topBlockAA011Da", "=", 
        RowBox[{RowBox[{"connection011Da", "\[LeftDoubleBracket]", 
            RowBox[{RowBox[{"4", ";;", "5"}], ",", RowBox[{"4", ";;", 
                "5"}]}], "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
          RowBox[{"aK", "\[Rule]", "aa"}]}]}], ";", 
      RowBox[{"rhoBasis011Da", "=", RowBox[{"TriangularizingBasisMatrix", 
          "[", RowBox[{"rho", ",", "aa"}], "]"}]}], ";", 
      RowBox[{"riccati011Da", "=", RowBox[{"TriangularizingRiccatiEquation", 
          "[", RowBox[{"topBlockAA011Da", ",", "rho", ",", "aa"}], "]"}]}], 
      ";", RowBox[{"exactTopConnection011Da", "=", 
        RowBox[{"TransformConnection", "[", RowBox[{"topBlockAA011Da", ",", 
            "rhoBasis011Da", ",", "aa"}], "]"}]}], ";", 
      RowBox[{"exactTriangularResidual011Da", "=", 
        RowBox[{"Simplify", "[", RowBox[{RowBox[{"exactTopConnection011Da", 
              "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
              "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
            RowBox[{"First", "[", RowBox[{"Solve", "[", RowBox[
                 {"riccati011Da", ",", RowBox[{SuperscriptBox["rho", 
                     "\[Prime]", MultilineFunction -> None], "[", "aa", 
                    "]"}]}], "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"{", RowBox[{"riccati011Da", ",", 
          "exactTriangularResidual011Da", ",", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"rho", "[", "aa", 
                    "]"}], "\[Equal]", RowBox[{"-", RowBox[
                     {"cutLocations011Da", "\[LeftDoubleBracket]", "1", 
                      "\[RightDoubleBracket]"}]}]}], ",", RowBox[
                 {RowBox[{"rho", "[", "aa", "]"}], "\[Equal]", RowBox[
                   {"-", RowBox[{"cutLocations011Da", "\[LeftDoubleBracket]", 
                      "2", "\[RightDoubleBracket]"}]}]}]}], "}"}], "/.", 
            "\[VeryThinSpace]", RowBox[{"eps", "\[Rule]", "0"}]}]}], 
        "}"}]}]], "Input"], Cell["Equivalently, if Bij denotes the original \
top 2 x 2 block, rho obeys rho'=B12 rho^2+(B22-B11)rho-B21. This makes the \
upper-right entry vanish exactly. The two leading-singularity values select \
the two epsilon=0 branches used as boundary data for a perturbative or \
numerical solution in epsilon.", "Text"], 
  Cell["8. Validation and companion evolution notebook", "Section"], 
  Cell["The exact connection was independently reproduced at the rational \
regression point by a global reduction of 400 IBP equations over 223 \
integrals. The companion triangular-evolution notebook constructs and \
verifies the complete five-master epsilon=0 evolution matrix from this \
connection.", "Text"], 
  Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"GenericityConditions011", "[", 
          "]"}], ",", RowBox[{"TangentialCheck011", "[", "]"}]}], "}"}]], 
   "Input"]}, WindowTitle -> "Cosmological Baikov: partial_a I011 system", 
 StyleDefinitions -> "Default.nb"]
