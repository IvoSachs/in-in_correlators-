(* Reconstruct the original I110 reduction notebook from CosmologicalBaikov.wl. *)

packageDirectory = DirectoryName[$InputFileName];

ClearAll[inputCell];
SetAttributes[inputCell, HoldAllComplete];
inputCell[expr_] := Cell[
  BoxData[ToBoxes[Defer[expr], StandardForm]],
  "Input"
];

notebook = Notebook[
  {
    Cell["Cosmological Baikov: the I110 reduction", "Title"],
    Cell[
      "This notebook is reconstructed from CosmologicalBaikov.wl. It derives the five-master I110 differential system, verifies the corrected top-sector identity, displays the staged IBP/Hermite reduction, and constructs the leading-singularity basis. All calculations are evaluated by the package; no previously saved notebook output is required.",
      "Text"
    ],

    Cell["1. Load the package", "Section"],
    inputCell[
      ClearAll["Global`*"];
      notebookDirectory = Quiet@Check[
        NotebookDirectory[], DirectoryName[$InputFileName]
      ];
      Get[FileNameJoin[{notebookDirectory, "CosmologicalBaikov.wl"}]];
    ],

    Cell["2. Kinematic polynomials", "Section"],
    Cell[
      "The dimensionally regulated measure is d^(1-2 epsilon)p2 d^(1-2 epsilon)p3. The basic invariants are lambda0=c^2/4-a b, h=a+b-c, and the corrected constant tildeLambda0 appearing in the decomposition of Lambda in terms of D1,D2,D3.",
      "Text"
    ],
    inputCell[
      {
        "lambda0" -> CosmologicalBaikov`Lambda0[],
        "h" -> CosmologicalBaikov`HInvariant[],
        "kappa" -> CosmologicalBaikov`KappaInvariant[],
        "tildeLambda0" -> CosmologicalBaikov`TildeLambda0[]
      }
    ],
    inputCell[
      Clear[p2, p3];
      d1 = (p3 - p2)^2 + CosmologicalBaikov`x0sq;
      d2 = p2^2 + CosmologicalBaikov`x2sq;
      d3 = p3^2 + CosmologicalBaikov`x3sq;
      lambda = CosmologicalBaikov`cK p2 p3
        - CosmologicalBaikov`bK p2^2
        - CosmologicalBaikov`aK p3^2
        + CosmologicalBaikov`Lambda0[];
      lambdaDecomposition =
        -CosmologicalBaikov`cK d1/2
        + (CosmologicalBaikov`cK/2 - CosmologicalBaikov`bK) d2
        + (CosmologicalBaikov`cK/2 - CosmologicalBaikov`aK) d3
        + CosmologicalBaikov`TildeLambda0[];
      VerificationTest[
        Expand[lambda - lambdaDecomposition],
        0,
        TestID -> "Lambda-decomposition"
      ]
    ],

    Cell["3. Master basis", "Section"],
    Cell[
      "The package uses CBI[u,s,v]=Ibar^(u s 0,v 0 0;0). The fifth master has one D4 numerator because v=-1.",
      "Text"
    ],
    inputCell[
      masters = CosmologicalBaikov`MasterBasis[];
      Column[masters]
    ],

    Cell["4. Scaling and parameter differentiation", "Section"],
    Cell[
      "ScalingIdentity implements the dimensionally regulated relation that lowers the extra power of Lambda. D6NumeratorReduction uses D6=D1-D2+2 D4-kappa. Their combination gives the raw partial_a derivative before the remaining IBP reduction.",
      "Text"
    ],
    inputCell[
      {
        CosmologicalBaikov`ScalingIdentity[1, 1, 0],
        CosmologicalBaikov`D6NumeratorReduction[1, 1, 0],
        CosmologicalBaikov`ParameterDerivativeA[1, 1, 0]
      }
    ],

    Cell["5. Vector IBPs and the tangential identity", "Section"],
    Cell[
      "Four vector IBPs, labelled pp,pq,qp,qq, close the mixed sector. Their combination generated by T=(c p2-2 a p3) partial_p2+(2 b p2-c p3) partial_p3 is tangent to Lambda and has zero divergence.",
      "Text"
    ],
    inputCell[
      ibps = CosmologicalBaikov`IBPIdentity[#, 1, 1, 0] & /@
        {"pp", "pq", "qp", "qq"};
      tangentialIBP = CosmologicalBaikov`TangentialIBPIdentity[1, 1, 0];
      {
        "number of vector IBPs" -> Length[ibps],
        "tangency and divergence check" -> CosmologicalBaikov`TangentialCheck[],
        "tangential IBP" -> tangentialIBP
      }
    ],

    Cell["6. Staged Hermite/IBP reduction", "Section"],
    Cell[
      "One-denominator Hermite identities first remove the elementary raised powers. A four-equation system then reduces the v=0 mixed integrals. At v=-1, three independent equations reduce the remaining numerator integrals and the fourth equation is retained as a consistency check.",
      "Text"
    ],
    inputCell[
      reduction = CosmologicalBaikov`ReductionData[];
      {
        "Hermite coefficients" -> reduction["HermiteCoefficients"],
        "v=0 mixed system dimensions" ->
          Dimensions[reduction["MixedMatrices"][[1]]],
        "v=-1 mixed system dimensions" ->
          Dimensions[reduction["MixedMatrices"][[2]]],
        "number of reduction rules" -> Length[reduction["Rules"]]
      }
    ],
    inputCell[
      genericRules = {
        CosmologicalBaikov`aK -> 2,
        CosmologicalBaikov`bK -> 3,
        CosmologicalBaikov`cK -> 1,
        CosmologicalBaikov`x0sq -> 5,
        CosmologicalBaikov`x2sq -> 7,
        CosmologicalBaikov`eps -> 1/7
      };
      VerificationTest[
        Together[reduction["FourthIBPResidual"] /. genericRules],
        0,
        TestID -> "unused-fourth-IBP-consistency"
      ]
    ],

    Cell["7. The exact five-master connection", "Section"],
    Cell[
      "The result is partial_a m=A_a m. The first three rows are compact; the last two are exact rational functions generated by the mixed systems. Together may be applied entrywise when a single rational denominator is desired.",
      "Text"
    ],
    inputCell[
      connection = CosmologicalBaikov`DifferentialMatrixA[];
      {
        "dimensions" -> Dimensions[connection],
        "contains unreduced integrals" ->
          Not@FreeQ[connection, _CosmologicalBaikov`CBI],
        "first three rows" -> MatrixForm[Take[connection, 3]]
      }
    ],
    inputCell[
      numericalConnection = CosmologicalBaikov`NumericalCrossCheck[];
      MatrixForm[numericalConnection]
    ],

    Cell["8. Algebraic top-sector identity", "Section"],
    Cell[
      "The corrected analogue of equation (5) expresses the derivative of the scalar three-denominator integral through its three two-denominator pinches. Da is an inert derivative head in this identity.",
      "Text"
    ],
    inputCell[
      CosmologicalBaikov`TopSectorIdentity[]
    ],

    Cell["9. Leading singularities of the top I110 sector", "Section"],
    Cell[
      "On D1=D2=0 the remaining Baikov coordinate is z=D4. The cut Gram polynomial has two roots zPlus,zMinus. Since the numerator master has one factor of D4, the combinations M5-zPlus M4 and M5-zMinus M4 isolate the two branches.",
      "Text"
    ],
    inputCell[
      cutLocations = CosmologicalBaikov`LeadingSingularityLocations[];
      cutBasis = CosmologicalBaikov`LeadingSingularityBasisMatrix[];
      {
        "cut polynomial" -> CosmologicalBaikov`CutGramPolynomial[z],
        "cut locations" -> cutLocations,
        "zeros" -> Simplify[
          CosmologicalBaikov`CutGramPolynomial /@ cutLocations
        ],
        "basis matrix" -> MatrixForm[cutBasis],
        "branch-adapted masters" -> cutBasis . masters[[4 ;; 5]]
      }
    ],
    inputCell[
      topBlock = connection[[4 ;; 5, 4 ;; 5]];
      epsilonZeroRules = Join[
        DeleteCases[genericRules, HoldPattern[CosmologicalBaikov`eps -> _]],
        {CosmologicalBaikov`eps -> 0}
      ];
      transformedTop = Map[
        Together,
        cutBasis . topBlock . Inverse[cutBasis] /. epsilonZeroRules,
        {2}
      ];
      {
        MatrixForm[transformedTop],
        VerificationTest[
          {transformedTop[[1, 2]], transformedTop[[2, 1]]},
          {0, 0},
          TestID -> "epsilon-zero-leading-singularity-diagonalization"
        ]
      }
    ],

    Cell["10. Exact finite-epsilon triangularization", "Section"],
    Cell[
      "At finite epsilon the algebraic leading-singularity basis generally leaves mixing proportional to epsilon. An a-dependent combination M5+rho(a) M4 is exactly triangular when rho obeys the Riccati equation below. TransformConnection includes the required gauge term (partial_a T) T^(-1).",
      "Text"
    ],
    inputCell[
      Clear[rho, aa];
      riccatiEquation =
        CosmologicalBaikov`TriangularizingRiccatiEquation[
          topBlock /. CosmologicalBaikov`aK -> aa,
          rho,
          aa
        ];
      riccatiTransform =
        CosmologicalBaikov`TriangularizingBasisMatrix[rho, aa];
      {riccatiEquation, MatrixForm[riccatiTransform]}
    ],

    Cell["11. Assumptions and regression tests", "Section"],
    inputCell[
      CosmologicalBaikov`GenericityConditions[]
    ],
    inputCell[
      testFile = FileNameJoin[{
        notebookDirectory, "CosmologicalBaikovTests.wlt"
      }];
      TestReport[testFile]
    ]
  },
  WindowTitle -> "Cosmological Baikov I110 reduction",
  StyleDefinitions -> "Default.nb"
];

outputPath = FileNameJoin[{packageDirectory, "CosmologicalBaikov.nb"}];
Put[notebook, outputPath];
Print[outputPath];
