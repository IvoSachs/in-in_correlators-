Cell[CellGroupData[{

Cell["3. Master basis", "Section",ExpressionUUID->"5811eeab-505b-42d8-815c-174b91694958"],

Cell["\<\
The package uses CBI[u,s,v]=Ibar^(u s 0,v 0 0;0). The fifth master has one D4 \
numerator because v=-1.\
\>", "Text",ExpressionUUID->"a80cc15e-119d-4a96-b34b-8a00cef89b82"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"masters", "=", 
