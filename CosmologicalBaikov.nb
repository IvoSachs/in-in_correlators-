Notebook[{

Cell[CellGroupData[{
Cell["Cosmological Baikov: the I110 reduction", "Title",ExpressionUUID->"89496493-3fb1-4eac-8530-fafefec216ec"],

Cell["\<\
This notebook is reconstructed from CosmologicalBaikov.wl. It derives the \
five-master I110 differential system, verifies the corrected top-sector \
identity, displays the staged IBP/Hermite reduction, and constructs the \
leading-singularity basis. All calculations are evaluated by the package; no \
previously saved notebook output is required.\
\>", "Text",ExpressionUUID->"a3ecddec-5b30-4856-8990-bdb485d9214c"],

Cell[CellGroupData[{

Cell["1. Load the package", "Section",ExpressionUUID->"0add5d7a-e37b-4e82-9e6c-7fbd85675add"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
  RowBox[{"notebookDirectory", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"DirectoryName", "[", "$InputFileName", "]"}]}], "]"}], "]"}]}],
   ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"notebookDirectory", ",", "\"\<CosmologicalBaikov.wl\>\""}], 
     "}"}], "]"}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[932]:=",ExpressionUUID->"7e271500-8772-444e-b77a-d612a2bf4093"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Kinematic polynomials", "Section",ExpressionUUID->"08a45f13-e64c-4b88-ad9b-e763f4524ee0"],

Cell["\<\
The dimensionally regulated measure is d^(1-2 epsilon)p2 d^(1-2 epsilon)p3. \
The basic invariants are lambda0=c^2/4-a b, h=a+b-c, and the corrected \
constant tildeLambda0 appearing in the decomposition of Lambda in terms of \
D1,D2,D3.\
\>", "Text",ExpressionUUID->"2cc58603-ca51-4a12-bb80-b8772bf10f3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<lambda0\>\"", "\[Rule]", 
    RowBox[{"CosmologicalBaikov`Lambda0", "[", "]"}]}], ",", 
   RowBox[{"\"\<h\>\"", "\[Rule]", 
    RowBox[{"CosmologicalBaikov`HInvariant", "[", "]"}]}], ",", 
   RowBox[{"\"\<kappa\>\"", "\[Rule]", 
    RowBox[{"CosmologicalBaikov`KappaInvariant", "[", "]"}]}], ",", 
   RowBox[{"\"\<tildeLambda0\>\"", "\[Rule]", 
    RowBox[{"CosmologicalBaikov`TildeLambda0", "[", "]"}]}]}], "}"}]], "Input",\

 CellLabel->
  "In[933]:=",ExpressionUUID->"40d7a0c5-47d3-465d-bec1-3d8baee30256"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"lambda0\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "aK"}], " ", "bK"}], "+", 
     FractionBox[
      SuperscriptBox["cK", "2"], "4"]}]}], ",", 
   RowBox[{"\<\"h\"\>", "\[Rule]", 
    RowBox[{"aK", "+", "bK", "-", "cK"}]}], ",", 
   RowBox[{"\<\"kappa\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "bK"}], "+", "cK", "+", "x0sq", "-", "x2sq"}]}], ",", 
   RowBox[{"\<\"tildeLambda0\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "aK"}], " ", "bK"}], "+", 
     FractionBox[
      SuperscriptBox["cK", "2"], "4"], "+", 
     RowBox[{"bK", " ", "x2sq"}], "+", 
     RowBox[{
      FractionBox["1", "2"], " ", "cK", " ", 
      RowBox[{"(", 
       RowBox[{"x0sq", "-", "x2sq", "-", "x3sq"}], ")"}]}], "+", 
     RowBox[{"aK", " ", "x3sq"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.001339389006212*^9},
 CellLabel->
  "Out[933]=",ExpressionUUID->"ba06b02f-3bc7-45d7-9ef3-205f3a73673b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"p2", ",", "p3"}], "]"}], ";", 
  RowBox[{"d1", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"p3", "-", "p2"}], ")"}], "2"], "+", 
    "CosmologicalBaikov`x0sq"}]}], ";", 
  RowBox[{"d2", "=", 
   RowBox[{
    SuperscriptBox["p2", "2"], "+", "CosmologicalBaikov`x2sq"}]}], ";", 
  RowBox[{"d3", "=", 
   RowBox[{
    SuperscriptBox["p3", "2"], "+", "CosmologicalBaikov`x3sq"}]}], ";", 
  RowBox[{"lambda", "=", 
   RowBox[{
    RowBox[{"CosmologicalBaikov`cK", " ", "p2", " ", "p3"}], "-", 
    RowBox[{"CosmologicalBaikov`bK", " ", 
     SuperscriptBox["p2", "2"]}], "-", 
    RowBox[{"CosmologicalBaikov`aK", " ", 
     SuperscriptBox["p3", "2"]}], "+", 
    RowBox[{"CosmologicalBaikov`Lambda0", "[", "]"}]}]}], ";", 
  RowBox[{"lambdaDecomposition", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"-", "CosmologicalBaikov`cK"}], ")"}], " ", "d1"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["CosmologicalBaikov`cK", "2"], "-", 
       "CosmologicalBaikov`bK"}], ")"}], " ", "d2"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["CosmologicalBaikov`cK", "2"], "-", 
       "CosmologicalBaikov`aK"}], ")"}], " ", "d3"}], "+", 
    RowBox[{"CosmologicalBaikov`TildeLambda0", "[", "]"}]}]}], ";", 
  RowBox[{"VerificationTest", "[", 
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{"lambda", "-", "lambdaDecomposition"}], "]"}], ",", "0", ",", 
    RowBox[{"TestID", "\[Rule]", "\"\<Lambda-decomposition\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[934]:=",ExpressionUUID->"3131d04b-8685-4836-8bce-0920d2efa947"],

