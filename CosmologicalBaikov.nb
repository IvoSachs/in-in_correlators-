Cell[CellGroupData[{

Cell["5. Vector IBPs and the tangential identity", "Section",ExpressionUUID->"2cabc76c-92d0-4cff-9bcf-24667db54501"],

Cell["\<\
Four vector IBPs, labelled pp,pq,qp,qq, close the mixed sector. Their \
combination generated by T=(c p2-2 a p3) partial_p2+(2 b p2-c p3) partial_p3 \
is tangent to Lambda and has zero divergence.\
\>", "Text",ExpressionUUID->"889f4de4-3644-4774-bc73-a37e34787cbb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ibps", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"CosmologicalBaikov`IBPIdentity", "[", 
       RowBox[{"#1", ",", "1", ",", "1", ",", "0"}], "]"}], "&"}], ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<pp\>\"", ",", "\"\<pq\>\"", ",", "\"\<qp\>\"", 
      ",", "\"\<qq\>\""}], "}"}]}]}], ";", 
  RowBox[{"tangentialIBP", "=", 
   RowBox[{"CosmologicalBaikov`TangentialIBPIdentity", "[", 
    RowBox[{"1", ",", "1", ",", "0"}], "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<number of vector IBPs\>\"", "\[Rule]", 
     RowBox[{"Length", "[", "ibps", "]"}]}], ",", 
    RowBox[{"\"\<tangency and divergence check\>\"", "\[Rule]", 
     RowBox[{"CosmologicalBaikov`TangentialCheck", "[", "]"}]}], ",", 
    RowBox[{"\"\<tangential IBP\>\"", "\[Rule]", "tangentialIBP"}]}], 
   "}"}]}]], "Input",
 CellLabel->
  "In[937]:=",ExpressionUUID->"48f44b77-4942-45bc-a5fa-b6dbfa850826"],

Cell[BoxData[
 RowBox[{"{", 
