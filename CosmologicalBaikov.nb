Cell[CellGroupData[{

Cell["4. Scaling and parameter differentiation", "Section",ExpressionUUID->"3bc4d7be-70e7-4b05-ae99-aa3992920c0a"],

Cell["\<\
ScalingIdentity implements the dimensionally regulated relation that lowers \
the extra power of Lambda. D6NumeratorReduction uses D6=D1-D2+2 D4-kappa. \
Their combination gives the raw partial_a derivative before the remaining IBP \
reduction.\
\>", "Text",ExpressionUUID->"4b6446a8-4a6b-48c4-8264-67e64a0edbc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"CosmologicalBaikov`ScalingIdentity", "[", 
    RowBox[{"1", ",", "1", ",", "0"}], "]"}], ",", 
   RowBox[{"CosmologicalBaikov`D6NumeratorReduction", "[", 
    RowBox[{"1", ",", "1", ",", "0"}], "]"}], ",", 
   RowBox[{"CosmologicalBaikov`ParameterDerivativeA", "[", 
    RowBox[{"1", ",", "1", ",", "0"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[936]:=",ExpressionUUID->"cd25856d-ca12-468b-bf36-c1f4c0035721"],

