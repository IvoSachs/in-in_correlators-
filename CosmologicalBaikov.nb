Cell[CellGroupData[{

Cell["6. Staged Hermite/IBP reduction", "Section",ExpressionUUID->"28d67ad4-c075-416c-aa2c-7404ccfa5c88"],

Cell["\<\
One-denominator Hermite identities first remove the elementary raised powers. \
A four-equation system then reduces the v=0 mixed integrals. At v=-1, three \
independent equations reduce the remaining numerator integrals and the fourth \
equation is retained as a consistency check.\
\>", "Text",ExpressionUUID->"101b4328-565f-4b14-944d-cf64b1cf0e28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"reduction", "=", 
   RowBox[{"CosmologicalBaikov`ReductionData", "[", "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<Hermite coefficients\>\"", "\[Rule]", 
     RowBox[{"reduction", "[", "\"\<HermiteCoefficients\>\"", "]"}]}], ",", 
    RowBox[{"\"\<v=0 mixed system dimensions\>\"", "\[Rule]", 
     RowBox[{"Dimensions", "[", 
      RowBox[{
       RowBox[{"reduction", "[", "\"\<MixedMatrices\>\"", "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}], "]"}]}], ",", 
    RowBox[{"\"\<v=-1 mixed system dimensions\>\"", "\[Rule]", 
     RowBox[{"Dimensions", "[", 
      RowBox[{
       RowBox[{"reduction", "[", "\"\<MixedMatrices\>\"", "]"}], "\[LeftDoubleBracket]",
        "2", "\[RightDoubleBracket]"}], "]"}]}], ",", 
    RowBox[{"\"\<number of reduction rules\>\"", "\[Rule]", 
     RowBox[{"Length", "[", 
      RowBox[{"reduction", "[", "\"\<Rules\>\"", "]"}], "]"}]}]}], 
   "}"}]}]], "Input",
 CellLabel->
  "In[938]:=",ExpressionUUID->"9e000d1c-e2b6-43fe-9412-11a77b3535b8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Hermite coefficients\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"r0\"\>", "\[Rule]", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"4", " ", "eps"}]}], 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"aK", "+", "bK", "-", "cK", "-", "x0sq"}], ")"}], " ", 
         "x0sq"}]]}], ",", 
      RowBox[{"\<\"r1\"\>", "\[Rule]", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"aK", "+", "bK", "-", "cK"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "eps"}]}], ")"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"4", " ", "eps"}]}], ")"}], " ", "x0sq"}]}], 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"aK", "+", "bK", "-", "cK", "-", "x0sq"}], ")"}], " ", 
         "x0sq"}]]}], ",", 
      RowBox[{"\<\"s0\"\>", "\[Rule]", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"4", " ", "eps"}]}], 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"aK", "-", "x2sq"}], ")"}], " ", "x2sq"}]]}], ",", 
      RowBox[{"\<\"s1\"\>", "\[Rule]", 
       FractionBox[
        RowBox[{
         RowBox[{"aK", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "eps"}]}], ")"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"4", " ", "eps"}]}], ")"}], " ", "x2sq"}]}], 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"aK", "-", "x2sq"}], ")"}], " ", "x2sq"}]]}], ",", 
      RowBox[{"\<\"qA\"\>", "\[Rule]", 
       FractionBox[
        RowBox[{
         RowBox[{"12", " ", "aK", " ", "bK"}], "-", 
         RowBox[{"4", " ", "aK", " ", "cK"}], "-", 
         RowBox[{"4", " ", "bK", " ", "cK"}], "+", 
         SuperscriptBox["cK", "2"], "-", 
         RowBox[{"16", " ", "aK", " ", "bK", " ", "eps"}], "+", 
         RowBox[{"4", " ", "aK", " ", "cK", " ", "eps"}], "+", 
         RowBox[{"4", " ", "bK", " ", "cK", " ", "eps"}]}], 
        RowBox[{"8", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"aK", "+", "bK", "-", "cK"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "eps"}], ")"}]}]]}], ",", 
      RowBox[{"\<\"qB\"\>", "\[Rule]", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"8", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "aK"}], "-", "bK", "+", "cK"}], ")"}], "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "eps"}], ")"}]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", " ", 
           SuperscriptBox["aK", "2"], " ", "bK"}], "+", 
          RowBox[{"4", " ", "aK", " ", 
           SuperscriptBox["bK", "2"]}], "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["aK", "2"], " ", "cK"}], "-", 
          RowBox[{"12", " ", "aK", " ", "bK", " ", "cK"}], "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["bK", "2"], " ", "cK"}], "+", 
          RowBox[{"7", " ", "aK", " ", 
           SuperscriptBox["cK", "2"]}], "+", 
          RowBox[{"7", " ", "bK", " ", 
           SuperscriptBox["cK", "2"]}], "-", 
          RowBox[{"3", " ", 
           SuperscriptBox["cK", "3"]}], "-", 
          RowBox[{"8", " ", 
           SuperscriptBox["aK", "2"], " ", "bK", " ", "eps"}], "-", 
          RowBox[{"8", " ", "aK", " ", 
           SuperscriptBox["bK", "2"], " ", "eps"}], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["aK", "2"], " ", "cK", " ", "eps"}], "+", 
          RowBox[{"16", " ", "aK", " ", "bK", " ", "cK", " ", "eps"}], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["bK", "2"], " ", "cK", " ", "eps"}], "-", 
          RowBox[{"6", " ", "aK", " ", 
           SuperscriptBox["cK", "2"], " ", "eps"}], "-", 
          RowBox[{"6", " ", "bK", " ", 
           SuperscriptBox["cK", "2"], " ", "eps"}], "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["cK", "3"], " ", "eps"}], "-", 
          RowBox[{"12", " ", "aK", " ", "bK", " ", "x0sq"}], "+", 
          RowBox[{"4", " ", "aK", " ", "cK", " ", "x0sq"}], "+", 
          RowBox[{"4", " ", "bK", " ", "cK", " ", "x0sq"}], "-", 
          RowBox[{
           SuperscriptBox["cK", "2"], " ", "x0sq"}], "+", 
          RowBox[{"16", " ", "aK", " ", "bK", " ", "eps", " ", "x0sq"}], "-", 
          
          RowBox[{"4", " ", "aK", " ", "cK", " ", "eps", " ", "x0sq"}], "-", 
          RowBox[{"4", " ", "bK", " ", "cK", " ", "eps", " ", "x0sq"}]}], 
         ")"}]}]}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"v=0 mixed system dimensions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"4", ",", "4"}], "}"}]}], ",", 
   RowBox[{"\<\"v=-1 mixed system dimensions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "3"}], "}"}]}], ",", 
   RowBox[{"\<\"number of reduction rules\"\>", "\[Rule]", "13"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0013394704581013`*^9},
 CellLabel->
  "Out[938]=",ExpressionUUID->"59364b70-625a-4300-85fa-d013e1e75acf"]
}, Open  ]],

