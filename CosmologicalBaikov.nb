Cell[CellGroupData[{

Cell["7. The exact five-master connection", "Section",ExpressionUUID->"9c627a04-3840-4aa8-b869-74c8b22d393f"],

Cell["\<\
The result is partial_a m=A_a m. The first three rows are compact; the last \
two are exact rational functions generated by the mixed systems. Together may \
be applied entrywise when a single rational denominator is desired.\
\>", "Text",ExpressionUUID->"13e6ac20-69d8-4385-933d-5e1db3aa2323"],

Cell[BoxData[
 RowBox[{
  RowBox[{"connection", "=", 
   RowBox[{"CosmologicalBaikov`DifferentialMatrixA", "[", "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<dimensions\>\"", "\[Rule]", 
     RowBox[{"Dimensions", "[", "connection", "]"}]}], ",", 
    RowBox[{"\"\<contains unreduced integrals\>\"", "\[Rule]", 
     RowBox[{"!", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"connection", ",", "_CosmologicalBaikov`CBI"}], "]"}]}]}], ",", 
    RowBox[{"\"\<first three rows\>\"", "\[Rule]", 
     TagBox[
      RowBox[{"Take", "[", 
       RowBox[{"connection", ",", "3"}], "]"}],
      Function[BoxForm`e$, 
       MatrixForm[BoxForm`e$]]]}]}], "}"}]}]], "Input",ExpressionUUID->\
"fb186ae8-7213-4fa0-a7d2-ecd6c4ef0332"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numericalConnection", "=", 
   RowBox[{"CosmologicalBaikov`NumericalCrossCheck", "[", "]"}]}], ";", 
  TagBox["numericalConnection",
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]]}]], "Input",ExpressionUUID->"f458c482-3b70-4bbc-\
bc99-e2a3dae4175a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Algebraic top-sector identity", "Section",ExpressionUUID->"159a345f-2819-428c-be20-4f58af486ee7"],

Cell["\<\
The corrected analogue of equation (5) expresses the derivative of the scalar \
three-denominator integral through its three two-denominator pinches. Da is \
an inert derivative head in this identity.\
\>", "Text",ExpressionUUID->"2c11999a-7315-4ca4-9661-e4889478b920"],

Cell[BoxData[
 RowBox[{"CosmologicalBaikov`TopSectorIdentity", "[", "]"}]], "Input",Expressi\
onUUID->"6f157853-ab55-45b8-a272-80a25fcf24f6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Leading singularities of the top I110 sector", "Section",ExpressionUUID->"bf1b9a5f-c2a9-428c-a0da-7fb257af0832"],

Cell["\<\
On D1=D2=0 the remaining Baikov coordinate is z=D4. The cut Gram polynomial \
has two roots zPlus,zMinus. Since the numerator master has one factor of D4, \
the combinations M5-zPlus M4 and M5-zMinus M4 isolate the two branches.\
\>", "Text",ExpressionUUID->"5313a1d1-082a-47ff-9270-00ce63c4363e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cutLocations", "=", 
   RowBox[{"CosmologicalBaikov`LeadingSingularityLocations", "[", "]"}]}], ";", 
  RowBox[{"cutBasis", "=", 
   RowBox[{"CosmologicalBaikov`LeadingSingularityBasisMatrix", "[", "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<cut polynomial\>\"", "\[Rule]", 
     RowBox[{"CosmologicalBaikov`CutGramPolynomial", "[", "z", "]"}]}], ",", 
    RowBox[{"\"\<cut locations\>\"", "\[Rule]", "cutLocations"}], ",", 
    RowBox[{"\"\<zeros\>\"", "\[Rule]", 
     RowBox[{"Simplify", "[", 
      RowBox[{"CosmologicalBaikov`CutGramPolynomial", "/@", "cutLocations"}], 
      "]"}]}], ",", 
    RowBox[{"\"\<basis matrix\>\"", "\[Rule]", 
     TagBox["cutBasis",
      Function[BoxForm`e$, 
       MatrixForm[BoxForm`e$]]]}], ",", 
    RowBox[{"\"\<branch-adapted masters\>\"", "\[Rule]", 
     RowBox[{"cutBasis", ".", 
      RowBox[{"masters", "\[LeftDoubleBracket]", 
       RowBox[{"4", ";;", "5"}], "\[RightDoubleBracket]"}]}]}]}], 
   "}"}]}]], "Input",ExpressionUUID->"c721925e-2ee6-4e9b-a9ef-5100c0934b85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"topBlock", "=", 
   RowBox[{"connection", "\[LeftDoubleBracket]", 
    RowBox[{
     RowBox[{"4", ";;", "5"}], ",", 
     RowBox[{"4", ";;", "5"}]}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"epsilonZeroRules", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"DeleteCases", "[", 
      RowBox[{"genericRules", ",", 
       RowBox[{"HoldPattern", "[", 
        RowBox[{"CosmologicalBaikov`eps", "\[Rule]", "_"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"CosmologicalBaikov`eps", "\[Rule]", "0"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"transformedTop", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Together", ",", 
     RowBox[{
      RowBox[{"cutBasis", ".", "topBlock", ".", 
       TemplateBox[{"cutBasis"},
        "Inverse"]}], "/.", "\[VeryThinSpace]", "epsilonZeroRules"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    TagBox["transformedTop",
     Function[BoxForm`e$, 
      MatrixForm[BoxForm`e$]]], ",", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"transformedTop", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{"transformedTop", "\[LeftDoubleBracket]", 
         RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{
      "TestID", 
       "\[Rule]", \
"\"\<epsilon-zero-leading-singularity-diagonalization\>\""}]}], "]"}]}], 
   "}"}]}]], "Input",ExpressionUUID->"2e94151c-48d8-4cf7-a0ff-f4966223fa89"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Exact finite-epsilon triangularization", "Section",ExpressionUUID->"7126bdfc-e553-4435-9dd6-1e1feda9222e"],

Cell["\<\
At finite epsilon the algebraic leading-singularity basis generally leaves \
mixing proportional to epsilon. An a-dependent combination M5+rho(a) M4 is \
exactly triangular when rho obeys the Riccati equation below. \
TransformConnection includes the required gauge term (partial_a T) T^(-1).\
\>", "Text",ExpressionUUID->"f7c615b2-e50e-4274-bde5-7eed63f4a0ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"rho", ",", "aa"}], "]"}], ";", 
  RowBox[{"riccatiEquation", "=", 
   RowBox[{"CosmologicalBaikov`TriangularizingRiccatiEquation", "[", 
    RowBox[{
     RowBox[{"topBlock", "/.", "\[VeryThinSpace]", 
      RowBox[{"CosmologicalBaikov`aK", "\[Rule]", "aa"}]}], ",", "rho", ",", 
     "aa"}], "]"}]}], ";", 
  RowBox[{"riccatiTransform", "=", 
   RowBox[{"CosmologicalBaikov`TriangularizingBasisMatrix", "[", 
    RowBox[{"rho", ",", "aa"}], "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{"riccatiEquation", ",", 
    TagBox["riccatiTransform",
     Function[BoxForm`e$, 
      MatrixForm[BoxForm`e$]]]}], "}"}]}]], "Input",ExpressionUUID->"d76f87e0-\
eef9-4884-864e-2157c19c1ec4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Assumptions and regression tests", "Section",ExpressionUUID->"a265aa51-f8bb-4ced-97ad-bb36b90866ca"],

Cell[BoxData[
 RowBox[{"CosmologicalBaikov`GenericityConditions", "[", "]"}]], "Input",Expre\
ssionUUID->"24f5f12e-e9e4-432a-bff1-a7da2ecaf04c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "notebookDirectory", ",", "\"\<CosmologicalBaikovTests.wlt\>\""}], "}"}],
     "]"}]}], ";", 
  RowBox[{"TestReport", "[", "testFile", "]"}]}]], "Input",ExpressionUUID->\
"076fbd98-83f1-4849-9fe9-386a810ff452"]
}, Open  ]]
}, Open  ]]
},
