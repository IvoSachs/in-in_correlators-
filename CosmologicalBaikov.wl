(* ::Package:: *)

BeginPackage["CosmologicalBaikov`"];

CBI::usage = "CBI[u,s,v] denotes Ibar^{u s 0, v 0 0; 0} in the D1-D2 subfamily.";
FullI::usage = "FullI[m1,m2,m3] is an inert head used by TopSectorIdentity.";
Da::usage = "Da[expr] is an inert a-derivative used by TopSectorIdentity.";

aK::usage = "aK is the parameter a.";
bK::usage = "bK is the parameter b.";
cK::usage = "cK is the parameter c.";
x0sq::usage = "x0sq denotes x_0^2.";
x2sq::usage = "x2sq denotes x_2^2.";
x3sq::usage = "x3sq denotes x_3^2.";
eps::usage = "eps is the dimensional regulator in d=1-2 eps.";

Lambda0::usage = "Lambda0[] returns c^2/4-a b.";
HInvariant::usage = "HInvariant[] returns a+b-c.";
KappaInvariant::usage = "KappaInvariant[] returns x0sq-x2sq-b+c.";
TildeLambda0::usage = "TildeLambda0[] returns the corrected coefficient in equations (6)-(7).";
MasterBasis::usage = "MasterBasis[] returns the five masters in equation (11), for the I110 subfamily.";

ScalingIdentity::usage = "ScalingIdentity[u,s,v] returns equation (9) at t=0 as an equality.";
D6NumeratorReduction::usage = "D6NumeratorReduction[u,s,v] removes a D6 numerator algebraically.";
ParameterDerivativeA::usage = "ParameterDerivativeA[u,s,v] returns the raw a-derivative following equation (10).";
IBPIdentity::usage = "IBPIdentity[type,u,s,v] returns a j=0 IBP identity. type is one of \"pp\", \"pq\", \"qp\", \"qq\".";
TangentialIBPIdentity::usage = "TangentialIBPIdentity[u,s,v] returns the IBP generated by equation (12).";
TangentialCheck::usage = "TangentialCheck[] verifies T Lambda=0 and div T=0.";

ReductionData::usage = "ReductionData[] constructs the staged Hermite/IBP reduction data.";
ReductionRules::usage = "ReductionRules[] returns the rules needed for the five-master differential system.";
ReduceIntegral::usage = "ReduceIntegral[expr] applies the staged reduction rules to expr.";
DifferentialMatrixA::usage = "DifferentialMatrixA[] returns A in d_a m=A.m. Use the option \"SimplifyFunction\"->Together for entrywise rational simplification.";
TopSectorIdentity::usage = "TopSectorIdentity[] returns the algebraic top-sector identity (6).";
GenericityConditions::usage = "GenericityConditions[] lists the denominators assumed nonzero by this basis and reduction.";
NumericalCrossCheck::usage = "NumericalCrossCheck[] evaluates A at a generic rational point used by the regression test.";
CutGramPolynomial::usage = "CutGramPolynomial[z] returns the Gram/Baikov polynomial on the D1=D2=0 maximal cut of the I110 sector.";
LeadingSingularityLocations::usage = "LeadingSingularityLocations[] returns the two D4 values on the maximal cut.";
LeadingSingularityBasisMatrix::usage = "LeadingSingularityBasisMatrix[] returns the 2 by 2 matrix mapping {I110,000;0,I110,-100;0} to the two branch-adapted combinations.";
TransformConnection::usage = "TransformConnection[A,T,var] transforms d_var m=A.m under n=T.m, including the gauge term (d_var T).Inverse[T].";
TriangularizingRiccatiEquation::usage = "TriangularizingRiccatiEquation[B,rho,var] returns the Riccati equation which makes {M5+rho[var] M4,M4} an exactly lower-triangular two-master system.";
TriangularizingBasisMatrix::usage = "TriangularizingBasisMatrix[rho,var] returns {{rho[var],1},{1,0}}, corresponding to the ordered basis {M5+rho[var] M4,M4}.";

Begin["`Private`"];

ClearAll[CBI, FullI, Da];

Lambda0[] := cK^2/4 - aK bK;
HInvariant[] := aK + bK - cK;
KappaInvariant[] := x0sq - x2sq - bK + cK;
TildeLambda0[] := (
  Lambda0[] + bK x2sq + aK x3sq
  + cK/2 (x0sq - x2sq - x3sq)
);

MasterBasis[] := {
  CBI[0, 0, 0], CBI[0, 1, 0], CBI[1, 0, 0],
  CBI[1, 1, 0], CBI[1, 1, -1]
};

(* D6 = D1-D2+2 D4-kappa. *)
D6NumeratorReduction[u_Integer, s_Integer, v_Integer] := (
  CBI[u - 1, s, v] - CBI[u, s - 1, v]
  + 2 CBI[u, s, v - 1] - KappaInvariant[] CBI[u, s, v]
);

ScalingIdentity[u_Integer, s_Integer, v_Integer] := (
  Lambda0[] CBI[u, s, v, 1]
  == -2 (1/2 - 2 eps - u - s - v) CBI[u, s, v]
     - 2 u x0sq CBI[u + 1, s, v]
     - 2 s x2sq CBI[u, s + 1, v]
     - v cK CBI[u, s, v + 1]
);

ParameterDerivativeA[u_Integer, s_Integer, v_Integer] := Together[-1/Lambda0[] (
  (3/2 - 2 eps - u - s - v) D6NumeratorReduction[u, s, v]
  + u x0sq D6NumeratorReduction[u + 1, s, v]
  + (v cK/2) D6NumeratorReduction[u, s, v + 1]
  + s x2sq D6NumeratorReduction[u, s + 1, v]
  - bK CBI[u, s, v]
)];

ClearAll[z1, z2, z4, xSP, ySP, zSP];
xSP = z2 - x2sq;
zSP = z4 - cK/2;
ySP = z1 - z2 + 2 z4 - x0sq + x2sq - cK;

ClearAll[polyToIntegrals, lambdaRaise, polyTimesLambdaRaise];

polyToIntegrals[poly_, {u_, s_, v_}] := Module[{terms},
  terms = CoefficientRules[Expand[poly], {z1, z2, z4}];
  Total[(Last[#] CBI[u - First[#][[1]], s - First[#][[2]],
       v - First[#][[3]]]) & /@ terms]
];

lambdaRaise[u_, s_, v_] := (
  -2 (1/2 - 2 eps - u - s - v) CBI[u, s, v]
  - 2 u x0sq CBI[u + 1, s, v]
  - 2 s x2sq CBI[u, s + 1, v]
  - v cK CBI[u, s, v + 1]
)/Lambda0[];

polyTimesLambdaRaise[poly_, {u_, s_, v_}] := Module[{terms},
  terms = CoefficientRules[Expand[poly], {z1, z2, z4}];
  Total[(Last[#] lambdaRaise[
       u - First[#][[1]], s - First[#][[2]], v - First[#][[3]]]) & /@ terms]
];

$contractions = <|
  "pp" -> <|"div" -> 1 - 2 eps,
    "D1" -> 2 (xSP - zSP), "D2" -> 2 xSP, "D4" -> zSP,
    "L" -> cK zSP - 2 bK xSP|>,
  "pq" -> <|"div" -> 0,
    "D1" -> 2 (zSP - ySP), "D2" -> 2 zSP, "D4" -> ySP,
    "L" -> cK ySP - 2 bK zSP|>,
  "qp" -> <|"div" -> 0,
    "D1" -> 2 (zSP - xSP), "D2" -> 0, "D4" -> xSP,
    "L" -> cK xSP - 2 aK zSP|>,
  "qq" -> <|"div" -> 1 - 2 eps,
    "D1" -> 2 (ySP - zSP), "D2" -> 0, "D4" -> zSP,
    "L" -> cK zSP - 2 aK ySP|>
|>;

IBPIdentity::type = "Unknown IBP type `1`. Use one of pp, pq, qp, qq.";
IBPIdentity[type_String, u_Integer, s_Integer, v_Integer] := Module[
  {q, idx = {u, s, v}},
  If[!KeyExistsQ[$contractions, type],
    Message[IBPIdentity::type, type]; Return[$Failed]
  ];
  q = $contractions[type];
  Together[
    q["div"] CBI[u, s, v]
    - u polyToIntegrals[q["D1"], {u + 1, s, v}]
    - s polyToIntegrals[q["D2"], {u, s + 1, v}]
    - v polyToIntegrals[q["D4"], {u, s, v + 1}]
    - 1/2 polyTimesLambdaRaise[q["L"], idx]
  ] == 0
];

TangentialIBPIdentity[u_Integer, s_Integer, v_Integer] := Module[{lhs},
  lhs = (
    cK First@IBPIdentity["pp", u, s, v]
    - 2 aK First@IBPIdentity["pq", u, s, v]
    + 2 bK First@IBPIdentity["qp", u, s, v]
    - cK First@IBPIdentity["qq", u, s, v]
  );
  Together[lhs] == 0
];

TangentialCheck[] := Module[{xp, yp, zp, lambda, tp, tq, tLambda, divergence},
  lambda = cK zp - bK xp - aK yp + Lambda0[];
  (* Contractions implement Vp=(c p-2 a q), Vq=(2 b p-c q). *)
  tp = cK (2 xp D[lambda, xp] + zp D[lambda, zp])
       - 2 aK (2 zp D[lambda, xp] + yp D[lambda, zp]);
  tq = 2 bK (xp D[lambda, zp] + 2 zp D[lambda, yp])
       - cK (zp D[lambda, zp] + 2 yp D[lambda, yp]);
  tLambda = Expand[tp + tq];
  divergence = (1 - 2 eps) cK - (1 - 2 eps) cK;
  {tLambda, Expand[divergence]}
];

ClearAll[buildReductionData];
buildReductionData[] := Module[
  {m, h, r0, r1, s0, s1, qR, qA, qB, subRules,
   mixed0, eq0, ca0, sol0, mixed1, eq1, ca1, sol1,
   d4, d5, solMat0, solMat1, row1, row2, row3, row4, row5,
   rawMatrix, allRules, residual1},

  m = MasterBasis[];
  h = HInvariant[];

  (* Corrected one-denominator Hermite reductions. *)
  r0 = (4 eps - 1)/(2 x0sq (h - x0sq));
  r1 = ((1 + 2 eps) h - (1 + 4 eps) x0sq)/(2 x0sq (h - x0sq));
  s0 = (4 eps - 1)/(2 x2sq (aK - x2sq));
  s1 = (aK (1 + 2 eps) - x2sq (1 + 4 eps))/(2 x2sq (aK - x2sq));

  qR = (1 - 2 eps)/(2 (1 - eps));
  qA = Together[qR Lambda0[]/h^2 + (cK - 2 aK) (2 bK - cK)/(4 h^2)];
  qB = Together[qR Lambda0[]/h + cK/2 - qA x0sq];

  subRules = {
    CBI[2, 0, 0] -> r0 m[[1]] + r1 m[[3]],
    CBI[0, 2, 0] -> s0 m[[1]] + s1 m[[2]],
    CBI[0, 1, -1] -> cK/(2 aK) (m[[1]] + (aK - x2sq) m[[2]]),
    CBI[0, 2, -1] -> cK/(2 aK) (m[[2]] + (aK - x2sq) (s0 m[[1]] + s1 m[[2]])),
    CBI[1, 0, -1] -> qA m[[1]] + qB m[[3]],
    CBI[2, 0, -1] -> qA m[[3]] + qB (r0 m[[1]] + r1 m[[3]])
  };

  mixed0 = {CBI[2, 1, -1], CBI[2, 1, 0], CBI[1, 2, 0], CBI[1, 2, -1]};
  eq0 = Numerator[Together[First[IBPIdentity[#, 1, 1, 0]] /. subRules]] & /@
    Keys[$contractions];
  ca0 = CoefficientArrays[eq0, mixed0];
  sol0 = Thread[mixed0 -> LinearSolve[ca0[[2]], -ca0[[1]]]];

  (* The v=-1 system has one extra numerator CBI[1,1,-2].  Substitute sol0,
     then solve three independent equations; the fourth is a consistency check. *)
  mixed1 = {CBI[1, 1, -2], CBI[2, 1, -2], CBI[1, 2, -2]};
  eq1 = (First[IBPIdentity[#, 1, 1, -1]] /. subRules /. sol0) & /@
    Keys[$contractions];
  ca1 = CoefficientArrays[eq1, mixed1];
  sol1 = Thread[mixed1 -> LinearSolve[ca1[[2, 1 ;; 3]], -ca1[[1, 1 ;; 3]]]];
  residual1 = eq1[[4]] /. sol1;

  row1 = bK eps/Lambda0[] m[[1]];
  row2 = (
    (4 eps - 1)/(2 aK (aK - x2sq)) m[[1]]
    + (-1/(2 aK) + eps (bK/Lambda0[]
       + (aK - 2 x2sq)/(aK (aK - x2sq)))) m[[2]]
  );
  row3 = (
    (4 eps - 1)/(2 h (h - x0sq)) m[[1]]
    + (bK eps/Lambda0[] + (4 eps - 1)/(2 h)
       - eps/(h - x0sq)) m[[3]]
  );

  d4 = ParameterDerivativeA[1, 1, 0] /. subRules;
  d5 = ParameterDerivativeA[1, 1, -1] /. subRules /. sol0;
  solMat0 = Table[Coefficient[mixed0[[i]] /. sol0, m[[j]]], {i, 4}, {j, 5}];
  solMat1 = Table[Coefficient[mixed1[[i]] /. sol1, m[[j]]], {i, 3}, {j, 5}];
  row4 = (
    Table[Coefficient[d4, m[[j]]], {j, 5}]
    + Table[Coefficient[d4, mixed0[[i]]], {i, 4}] . solMat0
  );
  row5 = (
    Table[Coefficient[d5, m[[j]]], {j, 5}]
    + Table[Coefficient[d5, mixed1[[i]]], {i, 3}] . solMat1
  );

  rawMatrix = Join[
    {Table[Coefficient[row1, m[[j]]], {j, 5}]},
    {Table[Coefficient[row2, m[[j]]], {j, 5}]},
    {Table[Coefficient[row3, m[[j]]], {j, 5}]},
    {row4}, {row5}
  ];
  allRules = Join[subRules, sol0, sol1];

  <|
    "Masters" -> m,
    "SubtopologyRules" -> subRules,
    "MixedV0Rules" -> sol0,
    "MixedVMinus1Rules" -> sol1,
    "MixedMatrices" -> {ca0[[2]], ca1[[2, 1 ;; 3]]},
    "Rules" -> allRules,
    "RawMatrix" -> rawMatrix,
    "FourthIBPResidual" -> residual1,
    "HermiteCoefficients" -> <|"r0" -> r0, "r1" -> r1,
      "s0" -> s0, "s1" -> s1, "qA" -> qA, "qB" -> qB|>
  |>
];

ReductionData[] := ReductionData[] = buildReductionData[];
ReductionRules[] := ReductionData[]["Rules"];

ReduceIntegral[expr_] := FixedPoint[Expand[# /. ReductionRules[]] &, expr];

Options[DifferentialMatrixA] = {"SimplifyFunction" -> Identity};
DifferentialMatrixA[OptionsPattern[]] := Module[{f, matrix},
  f = OptionValue["SimplifyFunction"];
  matrix = ReductionData[]["RawMatrix"];
  Map[f, matrix, {2}]
];

TopSectorIdentity[] := (
  TildeLambda0[] Da[FullI[1, 1, 1]]
  == 1/2 (bK - x3sq) FullI[1, 1, 1]
     + 1/2 FullI[1, 1, 0]
     + (aK - cK/2) Da[FullI[1, 1, 0]]
     + (bK - cK/2) Da[FullI[1, 0, 1]]
     + cK/2 Da[FullI[0, 1, 1]]
);

GenericityConditions[] := And[
  Lambda0[] != 0, aK != 0, HInvariant[] != 0,
  x0sq != 0, x2sq != 0,
  aK - x2sq != 0, HInvariant[] - x0sq != 0,
  eps != 1
];

NumericalCrossCheck[] := Together[
  DifferentialMatrixA[] /. {
    aK -> 2, bK -> 3, cK -> 1, x0sq -> 5, x2sq -> 7, eps -> 1/7
  }
];

(* On D1=D2=0, with z=D4,
     p2^2=-x2sq,
     p3^2=2 z-x0sq+x2sq-cK,
     p2.p3=z-cK/2.
   Their Gram determinant is the cut Baikov polynomial below. *)
CutGramPolynomial[z_] := x0sq x2sq - (z - cK/2 + x2sq)^2;

LeadingSingularityLocations[] := {
  cK/2 - x2sq + Sqrt[x0sq x2sq],
  cK/2 - x2sq - Sqrt[x0sq x2sq]
};

(* Since M5 has one D4 numerator relative to M4, LS_i[M5]/LS_i[M4]=z_i.
   Each row therefore kills one of the two cut branches. *)
LeadingSingularityBasisMatrix[] := Module[{z = LeadingSingularityLocations[]},
  {{-z[[1]], 1}, {-z[[2]], 1}}
];

TransformConnection[matrix_, transform_, var_] :=
  (D[transform, var].Inverse[transform] +
    transform.matrix.Inverse[transform]);

TriangularizingBasisMatrix[rho_Symbol, var_Symbol] := {
  {rho[var], 1}, {1, 0}
};

TriangularizingRiccatiEquation[block_?MatrixQ, rho_Symbol, var_Symbol] /;
    Dimensions[block] === {2, 2} := (
  rho'[var] == rho[var]^2 block[[1, 2]]
    + rho[var] (block[[2, 2]] - block[[1, 1]])
    - block[[2, 1]]
);

End[];
EndPackage[];
