Notebook[{Cell["Integration of the lower 3 x 3 Cosmological-Baikov system", 
   "Title"], Cell["Here \"lower block\" means the lower-sector subsystem on \
the first three masters {I^(000,000;0), I^(010,000;0), I^(100,000;0)}, namely \
A[[1;;3,1;;3]]. The notebook constructs an analytic fundamental matrix and \
the boundary-value propagator U(a,a0), verifies them symbolically, and \
compares with NDSolve.", "Text"], Cell["1. Load the reduction", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], ";", 
      RowBox[{"notebookDirectory", "=", RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", RowBox[{RowBox[{"NotebookDirectory", "[", 
                "]"}], ",", RowBox[{"DirectoryName", "[", "$InputFileName", 
                "]"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"notebookDirectory", ",", 
              "\"CosmologicalBaikov.wl\""}], "}"}], "]"}], "]"}], ";"}]], 
   "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"masters", "=", 
        RowBox[{"MasterBasis", "[", "]"}]}], ";", 
      RowBox[{"connection", "=", RowBox[{"DifferentialMatrixA", "[", "]"}]}], 
      ";", RowBox[{"lowerMasters", "=", RowBox[{"masters", 
          "\[LeftDoubleBracket]", RowBox[{"1", ";;", "3"}], 
          "\[RightDoubleBracket]"}]}], ";", 
      RowBox[{"lowerBlock", "=", RowBox[{"Map", "[", 
          RowBox[{"Together", ",", RowBox[{"connection", 
              "\[LeftDoubleBracket]", RowBox[{RowBox[{"1", ";;", "3"}], ",", 
                RowBox[{"1", ";;", "3"}]}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      RowBox[{"{", RowBox[{"lowerMasters", ",", TagBox["lowerBlock", 
           Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}], "}"}]}]], 
   "Input"], Cell["The subsystem is triangular: M1 evolves independently, \
while M2 and M3 are driven only by M1. M2 and M3 do not mix with one \
another.", "Text"], Cell["2. Common quadrature", "Section"], 
  Cell["Define lambda(a)=c^2/4-a b and h(a)=a+b-c. After dividing by the \
homogeneous solutions, both driven equations reduce to the integral of (4 \
epsilon-1)/2 u^(-1/2-2 epsilon) (u-X)^(epsilon-1). On the real branch u>X>0 \
it is an incomplete beta function.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"aa", ",", "a0", ",", 
          "u", ",", "x"}], "]"}], ";", 
      RowBox[{RowBox[{"lam", "[", "t_", "]"}], ":=", 
        RowBox[{FractionBox[SuperscriptBox["cK", "2"], "4"], "-", 
          RowBox[{"t", " ", "bK"}]}]}], ";", 
      RowBox[{RowBox[{"h", "[", "t_", "]"}], ":=", 
        RowBox[{"t", "+", "bK", "-", "cK"}]}], ";", 
      RowBox[{RowBox[{"betaPrimitive", "[", RowBox[{"u_", ",", "x_"}], "]"}], 
        ":=", RowBox[{FractionBox["1", "2"], " ", 
          RowBox[{"(", RowBox[{RowBox[{"4", " ", "eps"}], "-", "1"}], ")"}], 
          " ", SuperscriptBox["x", RowBox[{RowBox[{"-", FractionBox["1", 
                "2"]}], "-", "eps"}]], " ", RowBox[{"Beta", "[", 
            RowBox[{RowBox[{"1", "-", FractionBox["x", "u"]}], ",", "eps", 
              ",", RowBox[{"eps", "+", FractionBox["1", "2"]}]}], "]"}]}]}], 
      ";", RowBox[{RowBox[{"primitiveIntegrand", "[", 
          RowBox[{"u_", ",", "x_"}], "]"}], ":=", 
        RowBox[{FractionBox["1", "2"], " ", RowBox[
           {"(", RowBox[{RowBox[{"4", " ", "eps"}], "-", "1"}], ")"}], " ", 
          SuperscriptBox["u", RowBox[{RowBox[{"-", FractionBox["1", "2"]}], 
             "-", RowBox[{"2", " ", "eps"}]}]], " ", SuperscriptBox[
           RowBox[{"(", RowBox[{"u", "-", "x"}], ")"}], 
           RowBox[{"eps", "-", "1"}]]}]}], ";", 
      RowBox[{"primitiveCheck", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"u"}]], 
                RowBox[{"betaPrimitive", "[", RowBox[{"u", ",", "x"}], 
                  "]"}]}], "-", RowBox[{"primitiveIntegrand", "[", 
                RowBox[{"u", ",", "x"}], "]"}]}], ",", 
            RowBox[{"Assumptions", "\[Rule]", RowBox[{"{", RowBox[
                 {RowBox[{"u", ">", "x", ">", "0"}], ",", RowBox[{"eps", ">", 
                    "0"}]}], "}"}]}]}], "]"}]}], ";", "primitiveCheck"}]], 
   "Input"], Cell["3. Fundamental matrix", "Section"], 
  Cell["The three diagonal homogeneous solutions are g1, g2 and g3 below. A \
convenient fundamental matrix F has its first column equal to the solution \
sourced by M1 and its remaining columns equal to the two homogeneous \
solutions.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"g1", "[", "t_", "]"}], ":=", 
        SuperscriptBox[RowBox[{"lam", "[", "t", "]"}], 
         RowBox[{"-", "eps"}]]}], ";", 
      RowBox[{RowBox[{"g2", "[", "t_", "]"}], ":=", 
        RowBox[{SuperscriptBox[RowBox[{"lam", "[", "t", "]"}], 
           RowBox[{"-", "eps"}]], " ", SuperscriptBox["t", 
           RowBox[{RowBox[{"2", " ", "eps"}], "-", FractionBox["1", "2"]}]], 
          " ", SuperscriptBox[RowBox[{"(", RowBox[{"t", "-", "x2sq"}], ")"}], 
           RowBox[{"-", "eps"}]]}]}], ";", 
      RowBox[{RowBox[{"g3", "[", "t_", "]"}], ":=", 
        RowBox[{SuperscriptBox[RowBox[{"lam", "[", "t", "]"}], 
           RowBox[{"-", "eps"}]], " ", SuperscriptBox[
           RowBox[{"h", "[", "t", "]"}], RowBox[{RowBox[{"2", " ", "eps"}], 
             "-", FractionBox["1", "2"]}]], " ", SuperscriptBox[
           RowBox[{"(", RowBox[{RowBox[{"h", "[", "t", "]"}], "-", "x0sq"}], 
             ")"}], RowBox[{"-", "eps"}]]}]}], ";", 
      RowBox[{RowBox[{"fundamentalMatrix", "[", "t_", "]"}], ":=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"g1", "[", "t", 
                  "]"}], ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{RowBox[{"g2", "[", "t", "]"}], " ", 
                  RowBox[{"betaPrimitive", "[", RowBox[{"t", ",", "x2sq"}], 
                    "]"}]}], ",", RowBox[{"g2", "[", "t", "]"}], ",", "0"}], 
              "}"}], ",", RowBox[{"{", RowBox[{RowBox[{RowBox[{"g3", "[", 
                    "t", "]"}], " ", RowBox[{"betaPrimitive", "[", 
                    RowBox[{RowBox[{"h", "[", "t", "]"}], ",", "x0sq"}], 
                    "]"}]}], ",", "0", ",", RowBox[{"g3", "[", "t", "]"}]}], 
              "}"}]}], "}"}]}], ";", 
      TagBox[RowBox[{"fundamentalMatrix", "[", "aa", "]"}], 
       Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"lowerBlockAA", "=", 
        RowBox[{"lowerBlock", "/.", "\[VeryThinSpace]", 
          RowBox[{"aK", "\[Rule]", "aa"}]}]}], ";", 
      RowBox[{"branchAssumptions", "=", 
        RowBox[{"{", RowBox[{RowBox[{"aa", ">", "x2sq", ">", "0"}], ",", 
            RowBox[{RowBox[{"h", "[", "aa", "]"}], ">", "x0sq", ">", "0"}], 
            ",", RowBox[{RowBox[{"lam", "[", "aa", "]"}], ">", "0"}], ",", 
            RowBox[{"eps", ">", "0"}]}], "}"}]}], ";", 
      RowBox[{"fundamentalResidual", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[
                  {"aa"}]], RowBox[{"fundamentalMatrix", "[", "aa", "]"}]}], 
              "-", RowBox[{"lowerBlockAA", ".", RowBox[{"fundamentalMatrix", 
                  "[", "aa", "]"}]}]}], ",", RowBox[{"Assumptions", 
              "\[Rule]", "branchAssumptions"}], ",", 
            RowBox[{"TransformationFunctions", "\[Rule]", RowBox[{"{", 
                RowBox[{"Automatic", ",", "PowerExpand"}], "}"}]}]}], 
          "]"}]}], ";", RowBox[{"VerificationTest", "[", 
        RowBox[{"fundamentalResidual", ",", RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", RowBox[{"{", RowBox[{"3", ",", "3"}], "}"}]}], 
            "]"}], ",", RowBox[{"TestID", "\[Rule]", 
            "\"analytic-fundamental-matrix\""}]}], "]"}]}]], "Input"], 
  Cell["4. Boundary-value evolution matrix", "Section"], 
  Cell["For initial data m(a0)=m0, the solution is m(a)=U(a,a0)m0. Writing U \
directly in terms of primitive differences avoids irrelevant integration \
constants and is better behaved when epsilon approaches zero.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"lowerEvolution", "[", 
          RowBox[{"t_", ",", "t0_"}], "]"}], ":=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox[RowBox[
                  {"g1", "[", "t", "]"}], RowBox[{"g1", "[", "t0", "]"}]], 
                ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox[RowBox[{RowBox[{"g2", "[", "t", 
                     "]"}], " ", RowBox[{"(", RowBox[{RowBox[
                        {"betaPrimitive", "[", RowBox[{"t", ",", "x2sq"}], 
                         "]"}], "-", RowBox[{"betaPrimitive", "[", RowBox[
                          {"t0", ",", "x2sq"}], "]"}]}], ")"}]}], 
                 RowBox[{"g1", "[", "t0", "]"}]], ",", FractionBox[
                 RowBox[{"g2", "[", "t", "]"}], RowBox[{"g2", "[", "t0", 
                   "]"}]], ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox[RowBox[{RowBox[{"g3", "[", "t", 
                     "]"}], " ", RowBox[{"(", RowBox[{RowBox[
                        {"betaPrimitive", "[", RowBox[{RowBox[{"h", "[", "t", 
                          "]"}], ",", "x0sq"}], "]"}], "-", RowBox[
                        {"betaPrimitive", "[", RowBox[{RowBox[{"h", "[", 
                          "t0", "]"}], ",", "x0sq"}], "]"}]}], ")"}]}], 
                 RowBox[{"g1", "[", "t0", "]"}]], ",", "0", ",", 
                FractionBox[RowBox[{"g3", "[", "t", "]"}], RowBox[{"g3", "[", 
                   "t0", "]"}]]}], "}"}]}], "}"}]}], ";", 
      RowBox[{"initialValueCheck", "=", RowBox[{"Simplify", "[", 
          RowBox[{"lowerEvolution", "[", RowBox[{"a0", ",", "a0"}], "]"}], 
          "]"}]}], ";", RowBox[
       {"{", RowBox[{TagBox[RowBox[{"lowerEvolution", "[", 
             RowBox[{"aa", ",", "a0"}], "]"}], Function[BoxForm`e$, 
            MatrixForm[BoxForm`e$]]], ",", "initialValueCheck"}], "}"}]}]], 
   "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"evolutionAssumptions", "=", 
        RowBox[{"Join", "[", RowBox[{"branchAssumptions", ",", 
            RowBox[{"{", RowBox[{RowBox[{"a0", ">", "x2sq"}], ",", 
                RowBox[{RowBox[{"h", "[", "a0", "]"}], ">", "x0sq"}], ",", 
                RowBox[{RowBox[{"lam", "[", "a0", "]"}], ">", "0"}]}], 
              "}"}]}], "]"}]}], ";", RowBox[{"evolutionResidual", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"aa"}]], 
                RowBox[{"lowerEvolution", "[", RowBox[{"aa", ",", "a0"}], 
                  "]"}]}], "-", RowBox[{"lowerBlockAA", ".", RowBox[
                 {"lowerEvolution", "[", RowBox[{"aa", ",", "a0"}], 
                  "]"}]}]}], ",", RowBox[{"Assumptions", "\[Rule]", 
              "evolutionAssumptions"}], ",", RowBox[
             {"TransformationFunctions", "\[Rule]", RowBox[{"{", 
                RowBox[{"Automatic", ",", "PowerExpand"}], "}"}]}]}], 
          "]"}]}], ";", RowBox[{"VerificationTest", "[", 
        RowBox[{RowBox[{"{", RowBox[{"initialValueCheck", ",", 
              "evolutionResidual"}], "}"}], ",", 
          RowBox[{"{", RowBox[{RowBox[{"IdentityMatrix", "[", "3", "]"}], 
              ",", RowBox[{"ConstantArray", "[", RowBox[{"0", ",", 
                  RowBox[{"{", RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], 
            "}"}], ",", RowBox[{"TestID", "\[Rule]", 
            "\"boundary-value-evolution-operator\""}]}], "]"}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"m10", ",", "m20", ",", 
          "m30"}], "]"}], ";", RowBox[{"initialMasters", "=", 
        RowBox[{"{", RowBox[{"m10", ",", "m20", ",", "m30"}], "}"}]}], ";", 
      RowBox[{RowBox[{"lowerSolution", "[", RowBox[{"t_", ",", "t0_", ",", 
            "initial_List"}], "]"}], ":=", 
        RowBox[{RowBox[{"lowerEvolution", "[", RowBox[{"t", ",", "t0"}], 
            "]"}], ".", "initial"}]}], ";", 
      RowBox[{"lowerSolution", "[", RowBox[{"aa", ",", "a0", ",", 
          "initialMasters"}], "]"}]}]], "Input"], 
  Cell["5. The epsilon=0 limit", "Section"], Cell["At epsilon=0 the \
individual incomplete beta primitive contains an a-independent divergent \
constant, but it cancels from U(a,a0). A regular primitive for direct \
epsilon=0 work is ArcTanh[Sqrt[X/u]]/Sqrt[X]. Use its difference at the two \
endpoints in lowerEvolution.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"epsilonZeroPrimitive", "[", 
          RowBox[{"u_", ",", "x_"}], "]"}], ":=", FractionBox[
         RowBox[{"ArcTanh", "[", SqrtBox[FractionBox["x", "u"]], "]"}], 
         SqrtBox["x"]]}], ";", RowBox[{"epsilonZeroCheck", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"u"}]], 
                RowBox[{"epsilonZeroPrimitive", "[", RowBox[{"u", ",", "x"}], 
                  "]"}]}], "-", RowBox[{"(", RowBox[{RowBox[
                   {"primitiveIntegrand", "[", RowBox[{"u", ",", "x"}], 
                    "]"}], "/.", "\[VeryThinSpace]", RowBox[{"eps", 
                    "\[Rule]", "0"}]}], ")"}]}], ",", 
            RowBox[{"Assumptions", "\[Rule]", RowBox[{"u", ">", "x", ">", 
                "0"}]}]}], "]"}]}], ";", "epsilonZeroCheck"}]], "Input"], 
  Cell["6. Numerical cross-check", "Section"], Cell["The following Euclidean \
example compares the analytic propagator with a direct high-precision NDSolve \
integration. The final number is the norm of their difference.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"numericalParameters", "=", 
        RowBox[{"{", RowBox[{RowBox[{"bK", "\[Rule]", RowBox[{"-", "1"}]}], 
            ",", RowBox[{"cK", "\[Rule]", "0"}], ",", 
            RowBox[{"x0sq", "\[Rule]", "1"}], ",", RowBox[{"x2sq", "\[Rule]", 
              "1"}], ",", RowBox[{"eps", "\[Rule]", FractionBox["1", 
               "7"]}]}], "}"}]}], ";", RowBox[{"numericalInitial", "=", 
        RowBox[{"{", RowBox[{"2", ",", RowBox[{"-", "1"}], ",", "3"}], 
          "}"}]}], ";", RowBox[{"analyticEndpoint", "=", 
        RowBox[{RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"lowerEvolution", 
                  "[", RowBox[{"4", ",", "3"}], "]"}], "/.", 
                "\[VeryThinSpace]", "numericalParameters"}], ",", "40"}], 
            "]"}], ".", "numericalInitial"}]}], ";", 
      RowBox[{RowBox[{"numericalBlock", "[", RowBox[{"t_", "?", "NumericQ"}], 
          "]"}], ":=", RowBox[{"N", "[", RowBox[
           {RowBox[{RowBox[{"lowerBlock", "/.", "\[VeryThinSpace]", 
                "numericalParameters"}], "/.", "\[VeryThinSpace]", 
              RowBox[{"aK", "\[Rule]", "t"}]}], ",", "40"}], "]"}]}], ";", 
      RowBox[{"numericalSolution", "=", RowBox[{"NDSolveValue", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{SuperscriptBox[
                     "vector", "\[Prime]", MultilineFunction -> None], "[", 
                    "t", "]"}], "\[Equal]", RowBox[{RowBox[{"numericalBlock", 
                      "[", "t", "]"}], ".", RowBox[{"vector", "[", "t", 
                      "]"}]}]}], ",", RowBox[{RowBox[{"vector", "[", "3", 
                    "]"}], "\[Equal]", "numericalInitial"}]}], "}"}], ",", 
            "vector", ",", RowBox[{"{", RowBox[{"t", ",", "3", ",", "4"}], 
              "}"}], ",", RowBox[{"WorkingPrecision", "\[Rule]", "40"}], ",", 
            RowBox[{"AccuracyGoal", "\[Rule]", "25"}], ",", 
            RowBox[{"PrecisionGoal", "\[Rule]", "25"}], ",", 
            RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}]}], "]"}]}], ";", 
      RowBox[{"numericalEndpoint", "=", RowBox[{"numericalSolution", "[", 
          "4", "]"}]}], ";", RowBox[{"{", RowBox[{"analyticEndpoint", ",", 
          "numericalEndpoint", ",", RowBox[{"N", "[", 
            RowBox[{TemplateBox[{RowBox[{"analyticEndpoint", "-", 
                  "numericalEndpoint"}]}, "Norm"], ",", "10"}], "]"}]}], 
        "}"}]}]], "Input"], Cell["Branch and singular-locus remarks", 
   "Section"], Cell["The symbolic verification above chooses the real branch \
a>x2^2>0, h(a)>x0^2>0 and lambda(a)>0. Elsewhere the same formulas define the \
analytic continuation when all powers and incomplete beta functions are \
continued consistently along the integration path. Do not evolve through \
lambda=0, a=0, a=x2^2, h=0 or h=x0^2 without changing local basis or \
specifying a contour prescription.", "Text"]}, 
 WindowTitle -> "Cosmological Baikov: lower 3 x 3 integration", 
 StyleDefinitions -> "Default.nb"]
