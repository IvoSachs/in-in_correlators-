Notebook[{Cell["Leading-singularity basis for the I110 differential system", 
   "Title"], Cell["This notebook constructs the two maximal-cut \
leading-singularity branches of the top sector {I^(110,000;0), \
I^(110,-100;0)}, changes to branch-adapted linear combinations, and checks \
the differential equation. It also explains and implements the extra step \
needed for exact triangularity at finite epsilon.", "Text"], 
  Cell["1. Load the reduction and extract the top-sector block", "Section"], 
  Cell["The package orders the masters as {I^(000,000;0), I^(010,000;0), \
I^(100,000;0), I^(110,000;0), I^(110,-100;0)}. The last two rows and columns \
form the homogeneous top-sector block B.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], ";", 
      RowBox[{"notebookDirectory", "=", RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", RowBox[{RowBox[{"NotebookDirectory", "[", 
                "]"}], ",", RowBox[{"DirectoryName", "[", "$InputFileName", 
                "]"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"notebookDirectory", ",", 
              "\"CosmologicalBaikov.wl\""}], "}"}], "]"}], "]"}], ";"}]], 
   "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"masters", "=", 
        RowBox[{"MasterBasis", "[", "]"}]}], ";", 
      RowBox[{"connection", "=", RowBox[{"DifferentialMatrixA", "[", "]"}]}], 
      ";", RowBox[{"topBlock", "=", RowBox[{"connection", 
          "\[LeftDoubleBracket]", RowBox[{RowBox[{"4", ";;", "5"}], ",", 
            RowBox[{"4", ";;", "5"}]}], "\[RightDoubleBracket]"}]}], ";", 
      RowBox[{"{", RowBox[{"masters", ",", RowBox[{"Dimensions", "[", 
            "connection", "]"}]}], "}"}]}]], "Input"], 
  Cell["2. Maximal cut and leading singularities", "Section"], 
  Cell["Let z=D4. In terms of Baikov variables, p2^2=D2-x2^2, p2.p3=D4-c/2, \
and p3^2=D1-D2+2 D4-x0^2+x2^2-c. On D1=D2=0 their Gram determinant has two \
zeros zPlus and zMinus. These are the two one-dimensional leading-singularity \
branches.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"d1", ",", "d2", ",", 
          "d4"}], "]"}], ";", RowBox[{"p2Squared", "=", 
        RowBox[{"d2", "-", "x2sq"}]}], ";", 
      RowBox[{"p2Dotp3", "=", RowBox[{"d4", "-", FractionBox["cK", "2"]}]}], 
      ";", RowBox[{"p3Squared", "=", RowBox[{"d1", "-", "d2", "+", 
          RowBox[{"2", " ", "d4"}], "-", "x0sq", "+", "x2sq", "-", "cK"}]}], 
      ";", RowBox[{"gramPolynomial", "=", RowBox[{"Expand", "[", 
          RowBox[{RowBox[{"p2Squared", " ", "p3Squared"}], "-", 
            SuperscriptBox["p2Dotp3", "2"]}], "]"}]}], ";", 
      RowBox[{"cutGram", "=", RowBox[{"Factor", "[", 
          RowBox[{"gramPolynomial", "/.", "\[VeryThinSpace]", 
            RowBox[{"{", RowBox[{RowBox[{"d1", "\[Rule]", "0"}], ",", 
                RowBox[{"d2", "\[Rule]", "0"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"cutLocations", "=", RowBox[{"LeadingSingularityLocations", 
          "[", "]"}]}], ";", RowBox[{"{", RowBox[{"cutGram", ",", 
          "cutLocations", ",", RowBox[{"Simplify", "[", 
            RowBox[{RowBox[{"(", RowBox[{RowBox[{"CutGramPolynomial", "[", 
                    "#1", "]"}], "&"}], ")"}], "/@", "cutLocations"}], 
            "]"}]}], "}"}]}]], "Input"], Cell["M5=I^(110,-100;0) has one \
factor of D4 in its numerator relative to M4=I^(110,000;0). Therefore \
LS_i(M5)/LS_i(M4)=z_i. The combinations M5-zPlus M4 and M5-zMinus M4 each \
kill one cut branch.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"cutBasis", "=", 
        RowBox[{"LeadingSingularityBasisMatrix", "[", "]"}]}], ";", 
      RowBox[{"newTopMasters", "=", RowBox[{"cutBasis", ".", 
          RowBox[{"masters", "\[LeftDoubleBracket]", 
            RowBox[{"4", ";;", "5"}], "\[RightDoubleBracket]"}]}]}], ";", 
      RowBox[{"leadingSingularityRows", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", RowBox[
                 {"cutLocations", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{"1", ",", RowBox[{"cutLocations", 
                  "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
              "}"}]}], "}"}]}], ";", RowBox[{"branchSupport", "=", 
        RowBox[{"Simplify", "[", RowBox[{"cutBasis", ".", 
            TemplateBox[{"leadingSingularityRows"}, "Transpose", 
             SyntaxForm -> SuperscriptBox]}], "]"}]}], ";", 
      RowBox[{"{", RowBox[{"newTopMasters", ",", "branchSupport", ",", 
          RowBox[{"Factor", "[", RowBox[{"Det", "[", "cutBasis", "]"}], 
            "]"}]}], "}"}]}]], "Input"], 
  Cell["3. Transform the differential equation", "Section"], 
  Cell["For n=T m and partial_a m=A m, the transformed connection is \
Anew=(partial_a T) T^(-1)+T A T^(-1). The derivative term must be retained \
for any a-dependent basis. Here the cut basis is independent of a, so this \
term vanishes.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"zero32", "=", RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", RowBox[{"{", RowBox[{"3", ",", "2"}], "}"}]}], 
          "]"}]}], ";", RowBox[{"zero23", "=", 
        RowBox[{"ConstantArray", "[", RowBox[{"0", ",", 
            RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"fullCutBasis", "=", RowBox[{"ArrayFlatten", "[", 
          RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"IdentityMatrix", 
                    "[", "3", "]"}], ",", "zero32"}], "}"}], ",", 
              RowBox[{"{", RowBox[{"zero23", ",", "cutBasis"}], "}"}]}], 
            "}"}], "]"}]}], ";", RowBox[{"transformedConnection", "=", 
        RowBox[{"TransformConnection", "[", RowBox[{"connection", ",", 
            "fullCutBasis", ",", "aK"}], "]"}]}], ";", 
      RowBox[{"transformedTopBlock", "=", RowBox[{"transformedConnection", 
          "\[LeftDoubleBracket]", RowBox[{RowBox[{"4", ";;", "5"}], ",", 
            RowBox[{"4", ";;", "5"}]}], "\[RightDoubleBracket]"}]}], ";"}]], 
   "Input"], Cell["At epsilon=0 the two branch-adapted masters decouple, so \
the 2 by 2 block is diagonal (and the full five-master matrix is \
block-lower-triangular). At finite epsilon, the remaining off-diagonal \
entries are proportional to epsilon; leading singularities alone do not make \
the exact finite-epsilon connection triangular.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"sampleKinematics", "=", 
        RowBox[{"{", RowBox[{RowBox[{"aK", "\[Rule]", "2"}], ",", 
            RowBox[{"bK", "\[Rule]", "3"}], ",", RowBox[{"cK", "\[Rule]", 
              "1"}], ",", RowBox[{"x0sq", "\[Rule]", "5"}], ",", 
            RowBox[{"x2sq", "\[Rule]", "7"}]}], "}"}]}], ";", 
      RowBox[{"sampleCutBlock", "=", RowBox[{"Map", "[", 
          RowBox[{"Factor", ",", RowBox[{"Map", "[", RowBox[{"Together", ",", 
                RowBox[{"transformedTopBlock", "/.", "\[VeryThinSpace]", 
                  "sampleKinematics"}], ",", RowBox[{"{", "2", "}"}]}], 
              "]"}], ",", RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      RowBox[{"sampleOffDiagonal", "=", 
        RowBox[{"{", RowBox[{RowBox[{"sampleCutBlock", 
              "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
              "\[RightDoubleBracket]"}], ",", RowBox[{"sampleCutBlock", 
              "\[LeftDoubleBracket]", RowBox[{"2", ",", "1"}], 
              "\[RightDoubleBracket]"}]}], "}"}]}], ";", 
      RowBox[{"{", RowBox[{TagBox[RowBox[{"sampleCutBlock", "/.", 
             "\[VeryThinSpace]", RowBox[{"eps", "\[Rule]", "0"}]}], 
           Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", 
          RowBox[{"Together", "[", RowBox[{"sampleOffDiagonal", "/.", 
              "\[VeryThinSpace]", RowBox[{"eps", "\[Rule]", "0"}]}], "]"}], 
          ",", RowBox[{"Factor", "/@", RowBox[{"Together", "[", 
              FractionBox["sampleOffDiagonal", "eps"], "]"}]}]}], "}"}]}]], 
   "Input"], Cell[BoxData[RowBox[{"VerificationTest", "[", 
      RowBox[{RowBox[{"Together", "[", RowBox[{"sampleOffDiagonal", "/.", 
            "\[VeryThinSpace]", RowBox[{"eps", "\[Rule]", "0"}]}], "]"}], 
        ",", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"TestID", "\[Rule]", 
          "\"cut-basis-diagonal-at-epsilon-zero\""}]}], "]"}]], "Input"], 
  Cell["4. Exact finite-epsilon triangularization", "Section"], 
  Cell["To triangularize exactly, define N=M5+rho(a) M4 and order the pair as \
{N,M4}. Vanishing of the M4 coefficient in partial_a N gives a Riccati \
equation. Its two epsilon=0 branches are selected by rho(a,0)=-zPlus or \
-zMinus. This is the missing gauge-transformation step if equation (22) is \
meant at finite epsilon.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"rho", ",", "aa", ",", 
          "b11", ",", "b12", ",", "b21", ",", "b22"}], "]"}], ";", 
      RowBox[{"symbolicBlock", "=", RowBox[
         {"{", RowBox[{RowBox[{"{", RowBox[{"b11", ",", "b12"}], "}"}], ",", 
            RowBox[{"{", RowBox[{"b21", ",", "b22"}], "}"}]}], "}"}]}], ";", 
      RowBox[{"rhoBasis", "=", RowBox[{"TriangularizingBasisMatrix", "[", 
          RowBox[{"rho", ",", "aa"}], "]"}]}], ";", 
      RowBox[{"riccatiEquation", "=", 
        RowBox[{"TriangularizingRiccatiEquation", "[", 
          RowBox[{"symbolicBlock", ",", "rho", ",", "aa"}], "]"}]}], ";", 
      RowBox[{"rhoConnection", "=", RowBox[{"TransformConnection", "[", 
          RowBox[{"symbolicBlock", ",", "rhoBasis", ",", "aa"}], "]"}]}], 
      ";", RowBox[{"triangularityCheck", "=", 
        RowBox[{"Simplify", "[", RowBox[{RowBox[{"rhoConnection", 
              "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
              "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
            RowBox[{"First", "[", RowBox[{"Solve", "[", RowBox[
                 {"riccatiEquation", ",", RowBox[{SuperscriptBox["rho", 
                     "\[Prime]", MultilineFunction -> None], "[", "aa", 
                    "]"}]}], "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"{", RowBox[{"riccatiEquation", ",", TagBox["rhoConnection", 
           Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", 
          "triangularityCheck"}], "}"}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"actualBlock", "=", 
        RowBox[{"topBlock", "/.", "\[VeryThinSpace]", 
          RowBox[{"aK", "\[Rule]", "aa"}]}]}], ";", 
      RowBox[{"actualRiccatiEquation", "=", 
        RowBox[{"TriangularizingRiccatiEquation", "[", 
          RowBox[{"actualBlock", ",", "rho", ",", "aa"}], "]"}]}], ";", 
      RowBox[{"initialDataPlus", "=", RowBox[{RowBox[{"rho", "[", "2", "]"}], 
          "\[Equal]", RowBox[{"(", RowBox[{RowBox[{"-", RowBox[
                 {"cutLocations", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "/.", "\[VeryThinSpace]", 
              RowBox[{"aK", "\[Rule]", "2"}]}], ")"}]}]}], ";", 
      RowBox[{"{", RowBox[{"actualRiccatiEquation", ",", "initialDataPlus"}], 
        "}"}]}]], "Input"], Cell["5. Numerical finite-epsilon example", 
   "Section"], Cell["This optional cell solves the exact Riccati equation at \
a generic point with epsilon=1/7. The residual shown at the end is the \
upper-right entry of the transformed top block in the ordered basis {N,M4}; \
it should be zero to the requested working precision.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"numericalParameters", "=", 
        RowBox[{"{", RowBox[{RowBox[{"bK", "\[Rule]", "3"}], ",", 
            RowBox[{"cK", "\[Rule]", "1"}], ",", RowBox[{"x0sq", "\[Rule]", 
              "5"}], ",", RowBox[{"x2sq", "\[Rule]", "7"}], ",", 
            RowBox[{"eps", "\[Rule]", FractionBox["1", "7"]}]}], "}"}]}], 
      ";", RowBox[{"numericalBlock", "=", RowBox[{"Map", "[", 
          RowBox[{"Together", ",", RowBox[{RowBox[{"topBlock", "/.", 
                "\[VeryThinSpace]", "numericalParameters"}], "/.", 
              "\[VeryThinSpace]", RowBox[{"aK", "\[Rule]", "aa"}]}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      RowBox[{"rhoInitial", "=", RowBox[{"N", "[", 
          RowBox[{RowBox[{RowBox[{"-", RowBox[{"cutLocations", 
                  "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
              "/.", "\[VeryThinSpace]", "numericalParameters"}], ",", "30"}], 
          "]"}]}], ";", RowBox[{"rhoSolution", "=", 
        RowBox[{"NDSolveValue", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{RowBox[{SuperscriptBox["rhoN", 
                     "\[Prime]", MultilineFunction -> None], "[", "aa", 
                    "]"}], "\[Equal]", RowBox[{RowBox[{SuperscriptBox[
                       RowBox[{"rhoN", "[", "aa", "]"}], "2"], " ", 
                      RowBox[{"numericalBlock", "\[LeftDoubleBracket]", 
                        RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
                    "+", RowBox[{RowBox[{"rhoN", "[", "aa", "]"}], " ", 
                      RowBox[{"(", RowBox[{RowBox[{"numericalBlock", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                          "\[RightDoubleBracket]"}], "-", RowBox[
                          {"numericalBlock", "\[LeftDoubleBracket]", RowBox[
                          {"1", ",", "1"}], "\[RightDoubleBracket]"}]}], 
                        ")"}]}], "-", RowBox[{"numericalBlock", 
                      "\[LeftDoubleBracket]", RowBox[{"2", ",", "1"}], 
                      "\[RightDoubleBracket]"}]}]}], ",", RowBox[
                 {RowBox[{"rhoN", "[", "2", "]"}], "\[Equal]", 
                  "rhoInitial"}]}], "}"}], ",", "rhoN", ",", 
            RowBox[{"{", RowBox[{"aa", ",", FractionBox["3", "2"], ",", 
                FractionBox["5", "2"]}], "}"}], ",", 
            RowBox[{"WorkingPrecision", "\[Rule]", "30"}]}], "]"}]}], ";", 
      RowBox[{"blockAtTwo", "=", RowBox[{"numericalBlock", "/.", 
          "\[VeryThinSpace]", RowBox[{"aa", "\[Rule]", "2"}]}]}], ";", 
      RowBox[{"triangularResidualAtTwo", "=", 
        RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{SuperscriptBox[
                 "rhoSolution", "\[Prime]", MultilineFunction -> None], "[", 
                "2", "]"}], "+", RowBox[{"blockAtTwo", 
                "\[LeftDoubleBracket]", RowBox[{"2", ",", "1"}], 
                "\[RightDoubleBracket]"}], "+", RowBox[{RowBox[
                 {"rhoSolution", "[", "2", "]"}], " ", RowBox[{"(", 
                  RowBox[{RowBox[{"blockAtTwo", "\[LeftDoubleBracket]", 
                      RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
                    "-", RowBox[{"blockAtTwo", "\[LeftDoubleBracket]", 
                      RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], 
                  ")"}]}], "-", RowBox[{SuperscriptBox[RowBox[{"rhoSolution", 
                   "[", "2", "]"}], "2"], " ", RowBox[{"blockAtTwo", 
                  "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
                  "\[RightDoubleBracket]"}]}]}], ",", "12"}], "]"}]}], ";", 
      RowBox[{"{", RowBox[{"rhoInitial", ",", RowBox[{"rhoSolution", "[", 
            "2", "]"}], ",", "triangularResidualAtTwo"}], "}"}]}]], "Input"], 
  Cell["Interpretation", "Section"], Cell["The leading-singularity basis is \
algebraic and is the natural epsilon=0 choice. It makes the top-sector block \
diagonal at epsilon=0 and leaves only O(epsilon) mixing. If exact \
triangularity for nonzero epsilon is required, rho(a) must satisfy the \
Riccati equation; simply diagonalizing B(a) pointwise is insufficient because \
it omits (partial_a T) T^(-1). Singular kinematic loci x0^2 x2^2=0 merge the \
two cut branches and require a different basis.", "Text"]}, 
 WindowTitle -> "Cosmological Baikov: leading-singularity basis", 
 StyleDefinitions -> "Default.nb"]
