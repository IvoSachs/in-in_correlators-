Notebook[
 {
  Cell[
   "Leading-singularity triangularization and evolution of the I011 sector", 
   "Title"], Cell["This notebook brings the five-master I011 connection to \
triangular form. The algebraic leading-singularity basis diagonalizes the top \
block at epsilon=0. At finite epsilon it leaves O(epsilon) mixing; an \
a-dependent Riccati transformation gives exact triangularity. The complete \
epsilon=0 evolution matrix is then constructed and verified numerically.", 
   "Text"], Cell["1. Load the I011 connection", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], ";", 
      RowBox[{"notebookDirectory", "=", RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", RowBox[{RowBox[{"NotebookDirectory", "[", 
                "]"}], ",", RowBox[{"DirectoryName", "[", "$InputFileName", 
                "]"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"notebookDirectory", ",", 
              "\"CosmologicalBaikov.wl\""}], "}"}], "]"}], "]"}], ";", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"notebookDirectory", ",", 
              "\"CosmologicalBaikov011.wl\""}], "}"}], "]"}], "]"}], ";"}]], 
   "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"masters011", "=", 
        RowBox[{"MasterBasis011", "[", "]"}]}], ";", 
      RowBox[{"connection011", "=", RowBox[{"DifferentialMatrixA011", "[", 
          "]"}]}], ";", RowBox[{"topBlock011", "=", 
        RowBox[{"connection011", "\[LeftDoubleBracket]", 
          RowBox[{RowBox[{"4", ";;", "5"}], ",", RowBox[{"4", ";;", "5"}]}], 
          "\[RightDoubleBracket]"}]}], ";", 
      RowBox[{"{", RowBox[{"masters011", ",", RowBox[{"Dimensions", "[", 
            "connection011", "]"}]}], "}"}]}]], "Input"], 
  Cell["2. Maximal cut and branch-adapted masters", "Section"], 
  Cell["On D2=D3=0, p2^2=-x2^2, p3^2=-x3^2 and p2.p3=D4-c/2. Hence the cut \
Gram polynomial is x2^2 x3^2-(D4-c/2)^2 and its zeros are zPlus=c/2+Sqrt[x2^2 \
x3^2] and zMinus=c/2-Sqrt[x2^2 x3^2].", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"cutLocations011", "=", 
        RowBox[{"LeadingSingularityLocations011", "[", "]"}]}], ";", 
      RowBox[{"cutBasis011", "=", RowBox[{"LeadingSingularityBasisMatrix011", 
          "[", "]"}]}], ";", RowBox[{"leadingSingularityRows011", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", RowBox[
                 {"cutLocations011", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{"1", ",", RowBox[{"cutLocations011", 
                  "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
              "}"}]}], "}"}]}], ";", RowBox[{"branchSupport011", "=", 
        RowBox[{"Simplify", "[", RowBox[{"cutBasis011", ".", 
            TemplateBox[{"leadingSingularityRows011"}, "Transpose", 
             SyntaxForm -> SuperscriptBox]}], "]"}]}], ";", 
      RowBox[{"newTopMasters011", "=", RowBox[{"cutBasis011", ".", 
          RowBox[{"masters011", "\[LeftDoubleBracket]", 
            RowBox[{"4", ";;", "5"}], "\[RightDoubleBracket]"}]}]}], ";", 
      RowBox[{"{", RowBox[{"cutLocations011", ",", "newTopMasters011", ",", 
          "branchSupport011", ",", RowBox[{"Factor", "[", 
            RowBox[{"Det", "[", "cutBasis011", "]"}], "]"}]}], "}"}]}]], 
   "Input"], Cell["The first new master M5-zPlus M4 vanishes on zPlus and is \
supported on zMinus. The second has the opposite support.", "Text"], 
  Cell["3. Algebraic triangularization at epsilon=0", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"fullCutBasis011", "=", 
        RowBox[{"ArrayFlatten", "[", RowBox[
           {"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"IdentityMatrix", "[", 
                    "3", "]"}], ",", RowBox[{"ConstantArray", "[", 
                    RowBox[{"0", ",", RowBox[{"{", RowBox[{"3", ",", "2"}], 
                        "}"}]}], "]"}]}], "}"}], ",", RowBox[{"{", 
                RowBox[{RowBox[{"ConstantArray", "[", RowBox[{"0", ",", 
                      RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "]"}], 
                  ",", "cutBasis011"}], "}"}]}], "}"}], "]"}]}], ";", 
      RowBox[{"cutConnection011", "=", RowBox[{"TransformConnection", "[", 
          RowBox[{"connection011", ",", "fullCutBasis011", ",", "aK"}], 
          "]"}]}], ";", RowBox[{"epsilonZeroCutConnection011", "=", 
        RowBox[{"cutConnection011", "/.", "\[VeryThinSpace]", 
          RowBox[{"eps", "\[Rule]", "0"}]}]}], ";", 
      RowBox[{"sourceBlock011", "=", RowBox[{"epsilonZeroCutConnection011", 
          "\[LeftDoubleBracket]", RowBox[{RowBox[{"4", ";;", "5"}], ",", 
            RowBox[{"1", ";;", "3"}]}], "\[RightDoubleBracket]"}]}], ";", 
      RowBox[{"sourceColumns23Check", "=", RowBox[{"Map", "[", 
          RowBox[{"Together", ",", RowBox[{"sourceBlock011", 
              "\[LeftDoubleBracket]", RowBox[{"All", ",", RowBox[{"2", ";;", 
                  "3"}]}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      "sourceColumns23Check"}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"regressionKinematics011", "=", 
        RowBox[{"{", RowBox[{RowBox[{"aK", "\[Rule]", "5"}], ",", 
            RowBox[{"bK", "\[Rule]", RowBox[{"-", "1"}]}], ",", 
            RowBox[{"cK", "\[Rule]", "1"}], ",", RowBox[{"x2sq", "\[Rule]", 
              "1"}], ",", RowBox[{"x3sq", "\[Rule]", "2"}]}], "}"}]}], ";", 
      RowBox[{"transformedTopAtPoint", "=", 
        RowBox[{"Map", "[", RowBox[{"Factor", ",", RowBox[{"Map", "[", 
              RowBox[{"Together", ",", RowBox[{RowBox[{"cutConnection011", 
                    "\[LeftDoubleBracket]", RowBox[{RowBox[{"4", ";;", "5"}], 
                      ",", RowBox[{"4", ";;", "5"}]}], 
                    "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
                  "regressionKinematics011"}], ",", RowBox[{"{", "2", 
                  "}"}]}], "]"}], ",", RowBox[{"{", "2", "}"}]}], "]"}]}], 
      ";", RowBox[{"offDiagonalAtPoint", "=", 
        RowBox[{"{", RowBox[{RowBox[{"transformedTopAtPoint", 
              "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
              "\[RightDoubleBracket]"}], ",", RowBox[
             {"transformedTopAtPoint", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
      ";", RowBox[{"{", RowBox[{TagBox["transformedTopAtPoint", 
           Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", 
          RowBox[{"Together", "[", RowBox[{"offDiagonalAtPoint", "/.", 
              "\[VeryThinSpace]", RowBox[{"eps", "\[Rule]", "0"}]}], "]"}], 
          ",", RowBox[{"Factor", "/@", RowBox[{"Together", "[", 
              FractionBox["offDiagonalAtPoint", "eps"], "]"}]}]}], "}"}]}]], 
   "Input"], Cell["Thus the complete five-master matrix is lower triangular \
at epsilon=0. At finite epsilon the two off-diagonal top entries are nonzero \
but proportional to epsilon.", "Text"], 
  Cell["4. Exact finite-epsilon triangularization", "Section"], 
  Cell["For exact triangularity define N=M5+rho(a) M4 and order the top pair \
as {N,M4}. The full five-master matrix is lower triangular when rho satisfies \
the Riccati equation below. The leading singularities select rho(a,0)=-zPlus \
or -zMinus.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"rho", ",", "aa"}], 
        "]"}], ";", RowBox[{"topBlockAA", "=", 
        RowBox[{"topBlock011", "/.", "\[VeryThinSpace]", 
          RowBox[{"aK", "\[Rule]", "aa"}]}]}], ";", 
      RowBox[{"rhoBasis011", "=", RowBox[{"TriangularizingBasisMatrix", "[", 
          RowBox[{"rho", ",", "aa"}], "]"}]}], ";", 
      RowBox[{"riccatiEquation011", "=", 
        RowBox[{"TriangularizingRiccatiEquation", "[", 
          RowBox[{"topBlockAA", ",", "rho", ",", "aa"}], "]"}]}], ";", 
      RowBox[{"exactTriangularTop011", "=", RowBox[{"TransformConnection", 
          "[", RowBox[{"topBlockAA", ",", "rhoBasis011", ",", "aa"}], 
          "]"}]}], ";", RowBox[{"exactTriangularCheck011", "=", 
        RowBox[{"Simplify", "[", RowBox[{RowBox[{"exactTriangularTop011", 
              "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
              "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
            RowBox[{"First", "[", RowBox[{"Solve", "[", RowBox[
                 {"riccatiEquation011", ",", RowBox[{SuperscriptBox["rho", 
                     "\[Prime]", MultilineFunction -> None], "[", "aa", 
                    "]"}]}], "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"{", RowBox[{"riccatiEquation011", ",", 
          "exactTriangularCheck011"}], "}"}]}]], "Input"], 
  Cell["5. Lower-sector epsilon-zero evolution", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"a0", ",", "ss"}], 
        "]"}], ";", RowBox[{RowBox[{"phi0", "[", RowBox[{"u_", ",", "x_"}], 
          "]"}], ":=", FractionBox[RowBox[{"ArcTanh", "[", 
           SqrtBox[FractionBox["x", "u"]], "]"}], SqrtBox["x"]]}], ";", 
      RowBox[{RowBox[{"lowerEvolution011", "[", RowBox[{"t_", ",", "t0_"}], 
          "]"}], ":=", RowBox[{"{", RowBox[
           {RowBox[{"{", RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{FractionBox["1", SqrtBox["t"]], " ", 
                  RowBox[{"(", RowBox[{RowBox[{"phi0", "[", RowBox[{"t", ",", 
                          "x2sq"}], "]"}], "-", RowBox[{"phi0", "[", 
                        RowBox[{"t0", ",", "x2sq"}], "]"}]}], ")"}]}], ",", 
                SqrtBox[FractionBox["t0", "t"]], ",", "0"}], "}"}], ",", 
            RowBox[{"{", RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], 
      ";", RowBox[{"lowerEvolution011", "[", RowBox[{"a0", ",", "a0"}], 
        "]"}]}]], "Input"], Cell["6. Homogeneous top-sector evolution", 
   "Section"], Cell["On the cut, LambdaCut(z,a)=c(z-c/2)+b x2^2+a \
x3^2+c^2/4-a b. Because the first branch-adapted master is supported on \
zMinus, the diagonal homogeneous matrix uses the cut locations in reversed \
order.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"supportedCutLocations011", "=", 
        RowBox[{"Reverse", "[", "cutLocations011", "]"}]}], ";", 
      RowBox[{RowBox[{"topHomogeneous011", "[", "t_", "]"}], ":=", 
        RowBox[{"DiagonalMatrix", "[", RowBox[
           {RowBox[{"(", RowBox[{FractionBox["1", SqrtBox[RowBox[
                   {"CutLambda011", "[", RowBox[{"#1", ",", "t"}], "]"}]]], 
                "&"}], ")"}], "/@", "supportedCutLocations011"}], "]"}]}], 
      ";", RowBox[{RowBox[{"topHomogeneousRatio011", "[", 
          RowBox[{"t_", ",", "t0_"}], "]"}], ":=", 
        RowBox[{RowBox[{"topHomogeneous011", "[", "t", "]"}], ".", 
          TemplateBox[{RowBox[{"topHomogeneous011", "[", "t0", "]"}]}, 
           "Inverse", SyntaxForm -> SuperscriptBox]}]}], ";", 
      RowBox[{"predictedTopAtPoint", "=", RowBox[{"Map", "[", 
          RowBox[{"Together", ",", RowBox[{RowBox[{RowBox[
                 {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"aa"}]], 
                    RowBox[{"topHomogeneous011", "[", "aa", "]"}]}], ".", 
                  TemplateBox[{RowBox[{"topHomogeneous011", "[", "aa", 
                      "]"}]}, "Inverse", SyntaxForm -> SuperscriptBox]}], 
                "/.", "\[VeryThinSpace]", "regressionKinematics011"}], "/.", 
              "\[VeryThinSpace]", RowBox[{"aa", "\[Rule]", "5"}]}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      RowBox[{"actualTopAtPoint", "=", RowBox[{"Map", "[", 
          RowBox[{"Together", ",", RowBox[
             {RowBox[{"epsilonZeroCutConnection011", "\[LeftDoubleBracket]", 
                RowBox[{RowBox[{"4", ";;", "5"}], ",", RowBox[{"4", ";;", 
                    "5"}]}], "\[RightDoubleBracket]"}], "/.", 
              "\[VeryThinSpace]", "regressionKinematics011"}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      RowBox[{"VerificationTest", "[", 
        RowBox[{RowBox[{"FullSimplify", "[", RowBox[{"actualTopAtPoint", "-", 
              "predictedTopAtPoint"}], "]"}], ",", 
          RowBox[{"ConstantArray", "[", RowBox[{"0", ",", RowBox[{"{", 
                RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
          RowBox[{"TestID", "\[Rule]", 
            "\"I011-cut-homogeneous-factors\""}]}], "]"}]}]], "Input"], 
  Cell["7. Full five-master evolution matrix", "Section"], 
  Cell["In the cut basis, write Ucut={{ULower,0},{K,R}}. Here \
R=H(a)H(a0)^(-1) and K=H(a) Integral[H(s)^(-1) S(s) ULower(s,a0),{s,a0,a}]. \
In this sector S has only its first column nonzero at epsilon=0. The \
evolution in the original basis is U=Tcut^(-1) Ucut Tcut.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", "evolutionMatrix011EpsilonZero", 
        "]"}], ";", RowBox[{RowBox[{"evolutionMatrix011EpsilonZero", "[", 
          RowBox[{RowBox[{"t1_", "?", "NumericQ"}], ",", 
            RowBox[{"t0_", "?", "NumericQ"}], ",", "kinematicRules_List", 
            ",", RowBox[{"workingPrecision_Integer", ":", "40"}]}], "]"}], 
        ":=", RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{"integrationVariable", ",", "pFull", ",", 
                "sourceExpression", ",", "kernelExpression", ",", 
                "integralMatrix", ",", "lowerBlock", ",", "topBlock", ",", 
                "sourceEvolution", ",", "cutEvolution"}], "}"}], ",", 
            RowBox[{RowBox[{"pFull", "=", RowBox[{"fullCutBasis011", "/.", 
                  "\[VeryThinSpace]", "kinematicRules"}]}], ";", 
              RowBox[{"sourceExpression", "=", RowBox[{"Map", "[", 
                  RowBox[{"Together", ",", RowBox[{RowBox[{"sourceBlock011", 
                        "/.", "\[VeryThinSpace]", "kinematicRules"}], "/.", 
                      "\[VeryThinSpace]", RowBox[{"aK", "\[Rule]", 
                        "integrationVariable"}]}], ",", RowBox[{"{", "2", 
                      "}"}]}], "]"}]}], ";", RowBox[{"kernelExpression", "=", 
                RowBox[{"Map", "[", RowBox[{"Together", ",", RowBox[
                     {RowBox[{TemplateBox[{RowBox[{"topHomogeneous011", "[", 
                          "integrationVariable", "]"}]}, "Inverse", 
                         SyntaxForm -> SuperscriptBox], ".", 
                        "sourceExpression", ".", RowBox[{"lowerEvolution011", 
                          "[", RowBox[{"integrationVariable", ",", "t0"}], 
                          "]"}]}], "/.", "\[VeryThinSpace]", 
                      "kinematicRules"}], ",", RowBox[{"{", "2", "}"}]}], 
                  "]"}]}], ";", RowBox[{"integralMatrix", "=", 
                RowBox[{"Table", "[", RowBox[{RowBox[{"If", "[", RowBox[
                       {RowBox[{"TrueQ", "[", RowBox[{RowBox[{"Together", 
                          "[", RowBox[{"kernelExpression", 
                          "\[LeftDoubleBracket]", RowBox[{"i", ",", "j"}], 
                          "\[RightDoubleBracket]"}], "]"}], "===", "0"}], 
                          "]"}], ",", "0", ",", RowBox[{"NIntegrate", "[", 
                          RowBox[{RowBox[{"kernelExpression", 
                          "\[LeftDoubleBracket]", RowBox[{"i", ",", "j"}], 
                          "\[RightDoubleBracket]"}], ",", RowBox[{"{", 
                          RowBox[{"integrationVariable", ",", "t0", ",", 
                          "t1"}], "}"}], ",", RowBox[{"WorkingPrecision", 
                          "\[Rule]", "workingPrecision"}], ",", RowBox[
                          {"AccuracyGoal", "\[Rule]", RowBox[{RowBox[
                          {"Floor", "[", FractionBox["workingPrecision", 
                          "2"], "]"}], "+", "5"}]}], ",", RowBox[
                          {"PrecisionGoal", "\[Rule]", RowBox[{RowBox[
                          {"Floor", "[", FractionBox["workingPrecision", 
                          "2"], "]"}], "+", "5"}]}], ",", RowBox[
                          {"MaxRecursion", "\[Rule]", "20"}]}], "]"}]}], 
                      "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "2"}], 
                      "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "3"}], 
                      "}"}]}], "]"}]}], ";", RowBox[{"lowerBlock", "=", 
                RowBox[{"N", "[", RowBox[{RowBox[{RowBox[
                       {"lowerEvolution011", "[", RowBox[{"t1", ",", "t0"}], 
                        "]"}], "/.", "\[VeryThinSpace]", "kinematicRules"}], 
                    ",", "workingPrecision"}], "]"}]}], ";", 
              RowBox[{"topBlock", "=", RowBox[{"N", "[", RowBox[
                   {RowBox[{RowBox[{"topHomogeneousRatio011", "[", RowBox[
                         {"t1", ",", "t0"}], "]"}], "/.", "\[VeryThinSpace]", 
                      "kinematicRules"}], ",", "workingPrecision"}], "]"}]}], 
              ";", RowBox[{"sourceEvolution", "=", RowBox[{"N", "[", 
                  RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[
                          {"topHomogeneous011", "[", "t1", "]"}], "/.", 
                          "\[VeryThinSpace]", "kinematicRules"}], ")"}], ".", 
                      "integralMatrix"}], ",", "workingPrecision"}], "]"}]}], 
              ";", RowBox[{"cutEvolution", "=", RowBox[{"ArrayFlatten", "[", 
                  RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"lowerBlock", 
                          ",", RowBox[{"ConstantArray", "[", RowBox[{"0", 
                          ",", RowBox[{"{", RowBox[{"3", ",", "2"}], "}"}]}], 
                          "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                         {"sourceEvolution", ",", "topBlock"}], "}"}]}], 
                    "}"}], "]"}]}], ";", RowBox[{"N", "[", RowBox[
                 {RowBox[{TemplateBox[{"pFull"}, "Inverse", SyntaxForm -> 
                      SuperscriptBox], ".", "cutEvolution", ".", "pFull"}], 
                  ",", "workingPrecision"}], "]"}]}]}], "]"}]}], ";", 
      "\"evolutionMatrix011EpsilonZero is defined\""}]], "Input"], 
  Cell["8. Numerical verification against the original system", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"numericalKinematics011", "=", 
        RowBox[{"{", RowBox[{RowBox[{"bK", "\[Rule]", RowBox[{"-", "1"}]}], 
            ",", RowBox[{"cK", "\[Rule]", "1"}], ",", 
            RowBox[{"x2sq", "\[Rule]", "1"}], ",", RowBox[{"x3sq", "\[Rule]", 
              "2"}]}], "}"}]}], ";", RowBox[{"analyticEvolution011", "=", 
        RowBox[{"evolutionMatrix011EpsilonZero", "[", 
          RowBox[{"6", ",", "5", ",", "numericalKinematics011", ",", "40"}], 
          "]"}]}], ";", TagBox["analyticEvolution011", 
       Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"simplifiedOriginalConnection011", "=", 
        RowBox[{"Map", "[", RowBox[{"Together", ",", 
            RowBox[{RowBox[{RowBox[{"connection011", "/.", 
                  "\[VeryThinSpace]", "numericalKinematics011"}], "/.", 
                "\[VeryThinSpace]", RowBox[{"eps", "\[Rule]", "0"}]}], "/.", 
              "\[VeryThinSpace]", RowBox[{"aK", "\[Rule]", "tt"}]}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
      RowBox[{"directEvolution011", "=", RowBox[{"NDSolveValue", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{SuperscriptBox[
                     "evolution", "\[Prime]", MultilineFunction -> None], 
                    "[", "tt", "]"}], "\[Equal]", RowBox[
                   {"simplifiedOriginalConnection011", ".", RowBox[
                     {"evolution", "[", "tt", "]"}]}]}], ",", RowBox[
                 {RowBox[{"evolution", "[", "5", "]"}], "\[Equal]", 
                  RowBox[{"IdentityMatrix", "[", "5", "]"}]}]}], "}"}], ",", 
            "evolution", ",", RowBox[{"{", RowBox[{"tt", ",", "5", ",", 
                "6"}], "}"}], ",", RowBox[{"WorkingPrecision", "\[Rule]", 
              "40"}], ",", RowBox[{"AccuracyGoal", "\[Rule]", "25"}], ",", 
            RowBox[{"PrecisionGoal", "\[Rule]", "25"}], ",", 
            RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}]}], "]"}]}], ";", 
      RowBox[{"evolutionError011", "=", RowBox[{"N", "[", 
          RowBox[{TemplateBox[{RowBox[{"analyticEvolution011", "-", 
                RowBox[{"directEvolution011", "[", "6", "]"}]}]}, "Norm"], 
            ",", "10"}], "]"}]}], ";", "evolutionError011"}]], "Input"], 
  Cell["Interpretation and limitations", "Section"], 
  Cell["The algebraic leading-singularity transformation gives a genuinely \
lower-triangular five-master connection at epsilon=0 and the explicit \
evolution matrix above. At finite epsilon, exact triangularity requires \
solving the displayed Riccati equation and retaining the gauge term \
(partial_a T)T^(-1). The evolution formulas assume nonzero cut Lambda values, \
x2^2 x3^2 != 0 and a consistent continuation of square roots and ArcTanh \
along the integration path.", "Text"]}, 
 WindowTitle -> "Cosmological Baikov: I011 triangular evolution", 
 StyleDefinitions -> "Default.nb"]
