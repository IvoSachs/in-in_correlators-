(* Build a consolidated notebook for partial_a of the I011 sector. *)

Get[FileNameJoin[{DirectoryName[$InputFileName], "CosmologicalBaikov.wl"}]];
Get[FileNameJoin[{DirectoryName[$InputFileName], "CosmologicalBaikov011.wl"}]];

ClearAll[inputCell];
SetAttributes[inputCell, HoldAllComplete];
inputCell[expr_] := Cell[
  BoxData[ToBoxes[Defer[expr], StandardForm]],
  "Input"
];

notebook = Notebook[
  {
    Cell["The partial_a differential system for the I011 pinch", "Title"],
    Cell[
      "This notebook specifically derives partial_a I011. It is not the partial_b equation obtained from the I110 system by substitution. The notebook constructs the master basis, the exact connection matrix, the leading-singularity triangular form at epsilon=0, and the exact finite-epsilon Riccati triangularization.",
      "Text"
    ],

    Cell["1. Load the implementation", "Section"],
    inputCell[
      ClearAll["Global`*"];
      notebookDirectory = Quiet@Check[
        NotebookDirectory[],
        DirectoryName[$InputFileName]
      ];
      Get[FileNameJoin[{notebookDirectory, "CosmologicalBaikov.wl"}]];
      Get[FileNameJoin[{notebookDirectory, "CosmologicalBaikov011.wl"}]];
    ],

    Cell["2. Why this is the a derivative", "Section"],
    Cell[
      "Write Lambda=c p2.p3-b p2^2-a p3^2+lambda0 with lambda0=c^2/4-a b. Therefore partial_a Lambda=-(p3^2+b)=-D6. In the I011 sector D3=p3^2+x3^2, so D6=D3+b-x3^2. By contrast partial_b Lambda=-(p2^2+a)=-D5.",
      "Text"
    ],
    inputCell[
      Clear[xScalar, yScalar, zScalar, d3Scalar];
      lambdaScalar =
        CosmologicalBaikov`cK zScalar -
        CosmologicalBaikov`bK xScalar -
        CosmologicalBaikov`aK yScalar +
        CosmologicalBaikov`Lambda0[];
      d6Scalar = yScalar + CosmologicalBaikov`bK;
      d3Scalar = yScalar + CosmologicalBaikov`x3sq;
      {
        Expand[D[lambdaScalar, CosmologicalBaikov`aK] + d6Scalar],
        Expand[d6Scalar -
          (d3Scalar + CosmologicalBaikov`bK -
            CosmologicalBaikov`x3sq)]
      }
    ],
    inputCell[
      rawDerivativeExample =
        CosmologicalBaikov011`ParameterDerivativeA011[1, 1, 0];
      scalingIdentityExample =
        CosmologicalBaikov011`ScalingIdentity011[1, 1, 0];
      {scalingIdentityExample, rawDerivativeExample}
    ],

    Cell["3. Master basis and IBP closure", "Section"],
    Cell[
      "Use J011[s,w,v]=Ibar^(0 s w,v 0 0;0), where s and w are the D2 and D3 powers and v is the D4 power. Four vector IBPs together with one-denominator Hermite reduction close on five masters.",
      "Text"
    ],
    inputCell[
      basis011Da = CosmologicalBaikov011`MasterBasis011[];
      reduction011Da = CosmologicalBaikov011`ReductionData011[];
      genericPoint011Da = {
        CosmologicalBaikov`aK -> 5,
        CosmologicalBaikov`bK -> -1,
        CosmologicalBaikov`cK -> 1,
        CosmologicalBaikov`x2sq -> 1,
        CosmologicalBaikov`x3sq -> 2,
        CosmologicalBaikov`eps -> 1/7
      };
      mixedRanks011Da = MatrixRank[# /. genericPoint011Da] & /@
        reduction011Da["MixedMatrices"];
      {
        basis011Da,
        mixedRanks011Da,
        Together[
          reduction011Da["FourthIBPResidual"] /. genericPoint011Da
        ]
      }
    ],
    Cell[
      "In full notation the basis is {I000,000;0, I010,000;0, I001,000;0, I011,000;0, I011,-100;0}. The 4 x 4 system at v=0 and the 3 x 3 system at v=-1 have full rank at generic kinematics.",
      "Text"
    ],

    Cell["4. Exact partial_a connection matrix", "Section"],
    inputCell[
      connection011Da =
        CosmologicalBaikov011`DifferentialMatrixA011[];
      lowerRows011Da = Map[
        Together,
        connection011Da[[1 ;; 3]],
        {2}
      ];
      {
        Dimensions[connection011Da],
        MatrixForm[lowerRows011Da]
      }
    ],
    Cell[
      "The exact fourth and fifth rows are rational functions generated by the two mixed IBP systems. They are stored without expensive cosmetic simplification. Use DifferentialMatrixA011[\"SimplifyFunction\"->Together] when a single fully combined denominator is required.",
      "Text"
    ],
    inputCell[
      connectionAtPoint011Da =
        CosmologicalBaikov011`NumericalCrossCheck011[];
      MatrixForm[connectionAtPoint011Da]
    ],
    inputCell[
      expectedConnection011Da = {
        {-4/147, 0, 0, 0, 0},
        {-3/280, -311/2940, 0, 0, 0},
        {0, 0, -4/147, 0, 0},
        {-165/45038, -895/472899, 976/472899, -2526/22519, 264/22519},
        {-72/22519, -1366/472899, -184/157633, 954/22519, -3630/22519}
      };
      {
        VerificationTest[
          connectionAtPoint011Da,
          expectedConnection011Da,
          TestID -> "partial-a-I011-connection"
        ],
        VerificationTest[
          FreeQ[connection011Da, _CosmologicalBaikov011`J011],
          True,
          TestID -> "partial-a-I011-IBP-closure"
        ]
      }
    ],

    Cell["5. Leading singularities", "Section"],
    Cell[
      "On D2=D3=0 the Gram polynomial is x2^2 x3^2-(D4-c/2)^2. Since the fifth master contains one D4 numerator relative to the fourth, their leading-singularity ratio on a branch is the corresponding D4 value.",
      "Text"
    ],
    inputCell[
      cutLocations011Da =
        CosmologicalBaikov011`LeadingSingularityLocations011[];
      cutBasis011Da =
        CosmologicalBaikov011`LeadingSingularityBasisMatrix011[];
      leadingSingularityRows011Da = {
        {1, cutLocations011Da[[1]]},
        {1, cutLocations011Da[[2]]}
      };
      {
        cutLocations011Da,
        cutBasis011Da . basis011Da[[4 ;; 5]],
        Simplify[
          cutBasis011Da . Transpose[leadingSingularityRows011Da]
        ]
      }
    ],

    Cell["6. Algebraic triangular form at epsilon=0", "Section"],
    inputCell[
      fullCutBasis011Da = ArrayFlatten[{
        {
          IdentityMatrix[3],
          ConstantArray[0, {3, 2}]
        },
        {
          ConstantArray[0, {2, 3}],
          cutBasis011Da
        }
      }];
      cutConnection011Da = CosmologicalBaikov`TransformConnection[
        connection011Da,
        fullCutBasis011Da,
        CosmologicalBaikov`aK
      ];
      triangularConnection011Da =
        cutConnection011Da /. CosmologicalBaikov`eps -> 0;
      topOffDiagonal011Da = {
        cutConnection011Da[[4, 5]],
        cutConnection011Da[[5, 4]]
      };
      sourceColumns23011Da = Map[
        Together,
        triangularConnection011Da[[4 ;; 5, 2 ;; 3]],
        {2}
      ];
      {
        Together[
          topOffDiagonal011Da /. CosmologicalBaikov`eps -> 0
        ],
        sourceColumns23011Da
      }
    ],
    inputCell[
      triangularPointRules011Da = {
        CosmologicalBaikov`aK -> 5,
        CosmologicalBaikov`bK -> -1,
        CosmologicalBaikov`cK -> 1,
        CosmologicalBaikov`x2sq -> 1,
        CosmologicalBaikov`x3sq -> 2
      };
      upperEntriesAtPoint011Da = Flatten@Table[
        If[
          j > i,
          Together[
            triangularConnection011Da[[i, j]] /.
              triangularPointRules011Da
          ],
          Nothing
        ],
        {i, 5},
        {j, 5}
      ];
      VerificationTest[
        upperEntriesAtPoint011Da,
        ConstantArray[0, Length[upperEntriesAtPoint011Da]],
        TestID -> "partial-a-I011-lower-triangular-at-epsilon-zero"
      ]
    ],
    Cell[
      "At epsilon=0 the top block is diagonal, so the complete five-master connection is lower triangular. Moreover, the two top masters are sourced only by the vacuum master; their source columns for I010 and I001 vanish identically. At nonzero epsilon the two top off-diagonal entries are proportional to epsilon.",
      "Text"
    ],

    Cell["7. Exact finite-epsilon triangular form", "Section"],
    Cell[
      "Leading singularities determine the epsilon=0 branches. For exact finite-epsilon triangularity, define N=M5+rho(a)M4 and order the top pair as {N,M4}. Because the basis is a-dependent, the gauge term (partial_a T)T^(-1) is essential.",
      "Text"
    ],
    inputCell[
      Clear[rho, aa];
      topBlockAA011Da =
        connection011Da[[4 ;; 5, 4 ;; 5]] /.
          CosmologicalBaikov`aK -> aa;
      rhoBasis011Da =
        CosmologicalBaikov`TriangularizingBasisMatrix[rho, aa];
      riccati011Da =
        CosmologicalBaikov`TriangularizingRiccatiEquation[
          topBlockAA011Da,
          rho,
          aa
        ];
      exactTopConnection011Da =
        CosmologicalBaikov`TransformConnection[
          topBlockAA011Da,
          rhoBasis011Da,
          aa
        ];
      exactTriangularResidual011Da = Simplify[
        exactTopConnection011Da[[1, 2]] /.
          First@Solve[riccati011Da, rho'[aa]]
      ];
      {
        riccati011Da,
        exactTriangularResidual011Da,
        {
          rho[aa] == -cutLocations011Da[[1]],
          rho[aa] == -cutLocations011Da[[2]]
        } /. CosmologicalBaikov`eps -> 0
      }
    ],
    Cell[
      "Equivalently, if Bij denotes the original top 2 x 2 block, rho obeys rho'=B12 rho^2+(B22-B11)rho-B21. This makes the upper-right entry vanish exactly. The two leading-singularity values select the two epsilon=0 branches used as boundary data for a perturbative or numerical solution in epsilon.",
      "Text"
    ],

    Cell["8. Validation and companion evolution notebook", "Section"],
    Cell[
      "The exact connection was independently reproduced at the rational regression point by a global reduction of 400 IBP equations over 223 integrals. The companion triangular-evolution notebook constructs and verifies the complete five-master epsilon=0 evolution matrix from this connection.",
      "Text"
    ],
    inputCell[
      {
        CosmologicalBaikov011`GenericityConditions011[],
        CosmologicalBaikov011`TangentialCheck011[]
      }
    ]
  },
  WindowTitle -> "Cosmological Baikov: partial_a I011 system",
  StyleDefinitions -> "Default.nb"
];

target = FileNameJoin[{
  DirectoryName[$InputFileName],
  "CosmologicalBaikov011DaComplete.nb"
}];
Put[notebook, target];
Print[target];
