Notebook[{

Cell[CellGroupData[{
Cell["Integration of the remaining two Cosmological-Baikov masters", "Title",ExpressionUUID->"55ffa011-83b2-48d2-9eb1-ce655600d555"],

Cell["\<\
This notebook integrates I^(110,000;0) and I^(110,-100;0) at epsilon=0. It \
first changes to the two leading-singularity combinations, where the \
homogeneous 2 x 2 block is diagonal, and then applies variation of constants \
using the already integrated lower 3 x 3 subsystem.\
\>", "Text",ExpressionUUID->"3f5d13ea-f1fa-4d17-b1de-443adcfd1a74"],

Cell[CellGroupData[{

Cell["1. Load and transform the differential system", "Section",ExpressionUUID->"846d82f8-b28b-400e-8356-db5339ff86ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
  RowBox[{"notebookDirectory", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"DirectoryName", "[", "$InputFileName", "]"}]}], "]"}], "]"}]}],
   ";", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"notebookDirectory", ",", "\"\<CosmologicalBaikov.wl\>\""}], 
     "}"}], "]"}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[594]:=",ExpressionUUID->"f43cdffb-407b-43a3-940d-6ac60e5f02fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"masters", "=", 
   RowBox[{"MasterBasis", "[", "]"}]}], ";", 
  RowBox[{"connection", "=", 
   RowBox[{"DifferentialMatrixA", "[", "]"}]}], ";", 
  RowBox[{"cutLocations", "=", 
   RowBox[{"LeadingSingularityLocations", "[", "]"}]}], ";", 
  RowBox[{"cutBasis", "=", 
   RowBox[{"LeadingSingularityBasisMatrix", "[", "]"}]}], ";", 
  RowBox[{"fullCutBasis", "=", 
   RowBox[{"ArrayFlatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", "cutBasis"}], 
       "}"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"epsilonZeroConnection", "=", 
   RowBox[{"connection", "/.", "\[VeryThinSpace]", 
    RowBox[{"eps", "\[Rule]", "0"}]}]}], ";", 
  RowBox[{"transformedEpsilonZeroConnection", "=", 
   RowBox[{"TransformConnection", "[", 
    RowBox[{"epsilonZeroConnection", ",", "fullCutBasis", ",", "aK"}], 
    "]"}]}], ";", 
  RowBox[{"lowerBlock0", "=", 
   RowBox[{"epsilonZeroConnection", "\[LeftDoubleBracket]", 
    RowBox[{
     RowBox[{"1", ";;", "3"}], ",", 
     RowBox[{"1", ";;", "3"}]}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"sourceBlock0", "=", 
   RowBox[{"transformedEpsilonZeroConnection", "\[LeftDoubleBracket]", 
    RowBox[{
     RowBox[{"4", ";;", "5"}], ",", 
     RowBox[{"1", ";;", "3"}]}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"transformedTopBlock0", "=", 
   RowBox[{"transformedEpsilonZeroConnection", "\[LeftDoubleBracket]", 
    RowBox[{
     RowBox[{"4", ";;", "5"}], ",", 
     RowBox[{"4", ";;", "5"}]}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"cutBasis", ".", 
     RowBox[{"masters", "\[LeftDoubleBracket]", 
      RowBox[{"4", ";;", "5"}], "\[RightDoubleBracket]"}]}], ",", 
    RowBox[{"Dimensions", "[", "sourceBlock0", "]"}]}], "}"}]}]], "Input",
 CellLabel->
  "In[607]:=",ExpressionUUID->"351299ab-bec8-4379-bfcd-fe2d7da8ca60"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"CBI", "[", 
       RowBox[{"1", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["cK", "2"]}], "+", "x2sq", "-", 
         SqrtBox[
          RowBox[{"x0sq", " ", "x2sq"}]]}], ")"}], " ", 
       RowBox[{"CBI", "[", 
        RowBox[{"1", ",", "1", ",", "0"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"CBI", "[", 
       RowBox[{"1", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["cK", "2"]}], "+", "x2sq", "+", 
         SqrtBox[
          RowBox[{"x0sq", " ", "x2sq"}]]}], ")"}], " ", 
       RowBox[{"CBI", "[", 
        RowBox[{"1", ",", "1", ",", "0"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0003558734694138`*^9, 4.0003576905038652`*^9},
 CellLabel->
  "Out[607]=",ExpressionUUID->"387a9fe8-823b-4255-90f5-933ae7a16b56"]
}, Open  ]],

Cell["\<\
The transformed masters are NPlus=M5-zPlus M4 and NMinus=M5-zMinus M4. NPlus \
is supported on the zMinus cut and NMinus on the zPlus cut; this reversal is \
important in the homogeneous factors below.\
\>", "Text",ExpressionUUID->"fb63853c-f327-4f7d-9bcd-dee79e1e4229"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Homogeneous top-sector solutions", "Section",ExpressionUUID->"ab037897-0fbe-4423-b005-3ab6a1366e13"],

Cell["\<\
On D1=D2=0, with z=D4, the Baikov polynomial appearing in the leading \
singularity is LambdaCut(z,a). At epsilon=0 each branch evolves as \
LambdaCut^(-1/2).\
\>", "Text",ExpressionUUID->"762ec6f3-e76b-4b09-8e99-c99d1e615fa1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"aa", ",", "a0", ",", "ss"}], "]"}], ";", 
  RowBox[{
   RowBox[{"cutLambda", "[", 
    RowBox[{"z_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"cK", " ", 
     RowBox[{"(", 
      RowBox[{"z", "-", 
       FractionBox["cK", "2"]}], ")"}]}], "+", 
    RowBox[{"bK", " ", "x2sq"}], "-", 
    RowBox[{"t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "z"}], "-", "x0sq", "+", "x2sq", "-", "cK"}], 
      ")"}]}], "+", 
    FractionBox[
     SuperscriptBox["cK", "2"], "4"], "-", 
    RowBox[{"t", " ", "bK"}]}]}], ";", 
  RowBox[{"supportedCutLocations", "=", 
   RowBox[{"Reverse", "[", "cutLocations", "]"}]}], ";", 
  RowBox[{
   RowBox[{"topHomogeneous", "[", "t_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         RowBox[{"cutLambda", "[", 
          RowBox[{"#1", ",", "t"}], "]"}]]], "&"}], ")"}], "/@", 
     "supportedCutLocations"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"topHomogeneousRatio", "[", 
    RowBox[{"t_", ",", "t0_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"topHomogeneous", "[", "t", "]"}], ".", 
    TemplateBox[{
      RowBox[{"topHomogeneous", "[", "t0", "]"}]},
     "Inverse"]}]}], ";", 
  RowBox[{"{", 
   RowBox[{"supportedCutLocations", ",", 
    TagBox[
     RowBox[{"topHomogeneous", "[", "aa", "]"}],
     Function[BoxForm`e$, 
      MatrixForm[BoxForm`e$]]]}], "}"}]}]], "Input",
 CellLabel->
  "In[608]:=",ExpressionUUID->"f80c43e6-cd23-4d97-a394-0d982edbccd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["cK", "2"], "-", "x2sq", "-", 
      SqrtBox[
       RowBox[{"x0sq", " ", "x2sq"}]]}], ",", 
     RowBox[{
      FractionBox["cK", "2"], "-", "x2sq", "+", 
      SqrtBox[
       RowBox[{"x0sq", " ", "x2sq"}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"\[Sqrt]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "aa"}], " ", "bK"}], "+", 
            FractionBox[
             SuperscriptBox["cK", "2"], "4"], "+", 
            RowBox[{"bK", " ", "x2sq"}], "+", 
            RowBox[{"cK", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "x2sq"}], "-", 
               SqrtBox[
                RowBox[{"x0sq", " ", "x2sq"}]]}], ")"}]}], "-", 
            RowBox[{"aa", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "cK"}], "-", "x0sq", "+", "x2sq", "+", 
               RowBox[{"2", " ", 
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["cK", "2"], "-", "x2sq", "-", 
                  SqrtBox[
                   RowBox[{"x0sq", " ", "x2sq"}]]}], ")"}]}]}], ")"}]}]}], 
           ")"}]}], ")"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"\[Sqrt]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "aa"}], " ", "bK"}], "+", 
            FractionBox[
             SuperscriptBox["cK", "2"], "4"], "+", 
            RowBox[{"bK", " ", "x2sq"}], "+", 
            RowBox[{"cK", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "x2sq"}], "+", 
               SqrtBox[
                RowBox[{"x0sq", " ", "x2sq"}]]}], ")"}]}], "-", 
            RowBox[{"aa", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "cK"}], "-", "x0sq", "+", "x2sq", "+", 
               RowBox[{"2", " ", 
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["cK", "2"], "-", "x2sq", "+", 
                  SqrtBox[
                   RowBox[{"x0sq", " ", "x2sq"}]]}], ")"}]}]}], ")"}]}]}], 
           ")"}]}], ")"}]}]}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.000355873528502*^9, 4.000357693560647*^9},
 CellLabel->
  "Out[608]=",ExpressionUUID->"835c8ecf-6945-4fc2-8081-e83c158c5b8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"homogeneousCheckPoint", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"aK", "\[Rule]", "5"}], ",", 
     RowBox[{"bK", "\[Rule]", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"cK", "\[Rule]", "1"}], ",", 
     RowBox[{"x0sq", "\[Rule]", "2"}], ",", 
     RowBox[{"x2sq", "\[Rule]", "1"}]}], "}"}]}], ";", 
  RowBox[{"topBlockAtCheckPoint", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Together", ",", 
     RowBox[{
     "transformedTopBlock0", "/.", "\[VeryThinSpace]", 
      "homogeneousCheckPoint"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
  RowBox[{"predictedTopBlockAtCheckPoint", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Together", ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[PartialD]", "aa"], 
         RowBox[{"topHomogeneous", "[", "aa", "]"}]}], ".", 
        TemplateBox[{
          RowBox[{"topHomogeneous", "[", "aa", "]"}]},
         "Inverse"]}], "/.", "\[VeryThinSpace]", "homogeneousCheckPoint"}], "/.",
       "\[VeryThinSpace]", 
      RowBox[{"aa", "\[Rule]", "5"}]}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
  RowBox[{"VerificationTest", "[", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"topBlockAtCheckPoint", "-", "predictedTopBlockAtCheckPoint"}], 
     "]"}], ",", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{
    "TestID", 
     "\[Rule]", "\"\<cut-leading-singularities-give-top-homogeneous-factors\>\
\""}]}], "]"}]}]], "Input",
 CellLabel->
  "In[609]:=",ExpressionUUID->"a4d56666-3917-47db-8bd1-1ae4103e166e"],

