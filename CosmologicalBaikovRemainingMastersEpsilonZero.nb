Cell[CellGroupData[{

Cell["4. Exact variation-of-constants quadrature", "Section",ExpressionUUID->"2cc5b9e3-b1f5-4a91-9354-dc9a7ab12c4b"],

Cell["\<\
Let ell0 be the three lower-master values and mTop0={M4(a0),M5(a0)}. In the \
leading-singularity basis n=P mTop, the exact epsilon=0 solution is \
n(a)=H(a)[H(a0)^(-1)P mTop0 + Integral(H(s)^(-1) S(s) ULower(s,a0) ell0,ds)]. \
The original two masters are recovered with P^(-1).\
\>", "Text",ExpressionUUID->"fd16e853-d9fa-4460-8294-54c210657a6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"topSourceKernel", "[", 
    RowBox[{"s_", ",", "t0_"}], "]"}], ":=", 
   RowBox[{
    TemplateBox[{
      RowBox[{"topHomogeneous", "[", "s", "]"}]},
     "Inverse"], ".", 
    RowBox[{"(", 
     RowBox[{"sourceBlock0", "/.", "\[VeryThinSpace]", 
      RowBox[{"aK", "\[Rule]", "s"}]}], ")"}], ".", 
    RowBox[{"lowerEvolution0", "[", 
     RowBox[{"s", ",", "t0"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"remainingTopFormal", "[", 
    RowBox[{
    "t_", ",", "t0_", ",", "lowerInitial_List", ",", "topInitial_List"}], 
    "]"}], ":=", 
   RowBox[{
    TemplateBox[{"cutBasis"},
     "Inverse"], ".", 
    RowBox[{"topHomogeneous", "[", "t", "]"}], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{"topHomogeneous", "[", "t0", "]"}]},
        "Inverse"], ".", "cutBasis", ".", "topInitial"}], "+", 
      TemplateBox[{
        RowBox[{
          RowBox[{"topSourceKernel", "[", 
            RowBox[{"ss", ",", "t0"}], "]"}], ".", "lowerInitial"}], "ss", 
        "t0", "t"},
       "InactiveIntegrate",
       DisplayFunction->(RowBox[{
          SubsuperscriptBox[
           StyleBox["\[Integral]", "Inactive"], #3, #4], 
          RowBox[{#, 
            RowBox[{
              StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
       InterpretationFunction->(RowBox[{
          RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
          RowBox[{#, ",", 
            RowBox[{"{", 
              RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}], ")"}]}]}],
   ";", 
  TagBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"M4", "[", "aa", "]"}], ",", 
      RowBox[{"M5", "[", "aa", "]"}]}], "}"}], "\[Equal]", 
    RowBox[{"remainingTopFormal", "[", 
     RowBox[{"aa", ",", "a0", ",", 
      RowBox[{"{", 
       RowBox[{"M10", ",", "M20", ",", "M30"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"M40", ",", "M50"}], "}"}]}], "]"}]}],
   HoldForm]}]], "Input",ExpressionUUID->"e0e3d809-580f-4cdc-a57e-\
1531c896716f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Numerical evaluator for arbitrary generic kinematics", "Section",ExpressionUUID->"f1c71509-11e2-4ada-94c3-3d67a18018c6"],

Cell["\<\
The function below evaluates only the explicit 2 x 3 quadrature. Before \
NIntegrate it simplifies the source matrix after substituting the requested \
kinematics, which is much faster than repeatedly evaluating the unsimplified \
IBP expressions.\
\>", "Text",ExpressionUUID->"02091af1-0061-443d-b98d-4c28ae7b4b9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "remainingMastersEpsilonZero", "]"}], ";", 
  RowBox[{
   RowBox[{"remainingMastersEpsilonZero", "[", 
    RowBox[{
     RowBox[{"t1_", "?", "NumericQ"}], ",", 
     RowBox[{"t0_", "?", "NumericQ"}], ",", "lowerInitial_List", ",", 
     "topInitial_List", ",", "kinematicRules_List", ",", 
     RowBox[{"workingPrecision_Integer", ":", "40"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "integrationVariable", ",", "pMatrix", ",", "sourceExpression", ",", 
       "kernelExpression", ",", "integralMatrix", ",", "nEndpoint", ",", 
       "lowerEndpoint", ",", "topEndpoint"}], "}"}], ",", 
     RowBox[{
