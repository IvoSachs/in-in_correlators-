Cell[CellGroupData[{

Cell["3. Epsilon-zero lower-sector propagator", "Section",ExpressionUUID->"8a71a1a5-ebea-4796-b86e-d76154ced334"],

Cell["\<\
At epsilon=0, M1 is constant. The other two lower masters use the regular \
primitive phi0(u,X)=ArcTanh[Sqrt[X/u]]/Sqrt[X].\
\>", "Text",ExpressionUUID->"ee6bb68d-fc5f-4a1f-bff8-8fbabbf01622"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "t_", "]"}], ":=", 
   RowBox[{"t", "+", "bK", "-", "cK"}]}], ";", 
  RowBox[{
   RowBox[{"phi0", "[", 
    RowBox[{"u_", ",", "x_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"ArcTanh", "[", 
     SqrtBox[
      FractionBox["x", "u"]], "]"}], 
    SqrtBox["x"]]}], ";", 
  RowBox[{
   RowBox[{"lowerEvolution0", "[", 
    RowBox[{"t_", ",", "t0_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SqrtBox["t"]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"phi0", "[", 
           RowBox[{"t", ",", "x2sq"}], "]"}], "-", 
          RowBox[{"phi0", "[", 
           RowBox[{"t0", ",", "x2sq"}], "]"}]}], ")"}]}], ",", 
       SqrtBox[
        FractionBox["t0", "t"]], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SqrtBox[
          RowBox[{"h", "[", "t", "]"}]]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"phi0", "[", 
           RowBox[{
            RowBox[{"h", "[", "t", "]"}], ",", "x0sq"}], "]"}], "-", 
          RowBox[{"phi0", "[", 
           RowBox[{
            RowBox[{"h", "[", "t0", "]"}], ",", "x0sq"}], "]"}]}], ")"}]}], ",",
        "0", ",", 
       SqrtBox[
        FractionBox[
         RowBox[{"h", "[", "t0", "]"}], 
         RowBox[{"h", "[", "t", "]"}]]]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"lowerEvolutionCheck", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "aa"], 
       RowBox[{"lowerEvolution0", "[", 
        RowBox[{"aa", ",", "a0"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"lowerBlock0", "/.", "\[VeryThinSpace]", 
         RowBox[{"aK", "\[Rule]", "aa"}]}], ")"}], ".", 
       RowBox[{"lowerEvolution0", "[", 
        RowBox[{"aa", ",", "a0"}], "]"}]}]}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"aa", ">", "x2sq", ">", "0"}], ",", 
        RowBox[{"a0", ">", "x2sq"}], ",", 
        RowBox[{
         RowBox[{"h", "[", "aa", "]"}], ">", "x0sq", ">", "0"}], ",", 
        RowBox[{
         RowBox[{"h", "[", "a0", "]"}], ">", "x0sq"}]}], "}"}]}], ",", 
     RowBox[{"TransformationFunctions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "PowerExpand"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"VerificationTest", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"lowerEvolution0", "[", 
        RowBox[{"a0", ",", "a0"}], "]"}], "]"}], ",", "lowerEvolutionCheck"}],
      "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"TestID", "\[Rule]", "\"\<epsilon-zero-lower-propagator\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[610]:=",ExpressionUUID->"3e259297-1293-4417-a088-1cdd80091824"],

